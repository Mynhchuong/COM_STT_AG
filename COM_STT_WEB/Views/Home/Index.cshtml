@model COM_STT_WEB.Models.Account.EmployeeInfo
@{
    ViewData["Title"] = "Trang chủ";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 11 ? "Chào buổi sáng" : hour < 14 ? "Chào buổi trưa" : hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";

    var quickLinks = new (string Controller, string Action, string Emoji, string Title, string Gradient)[]
    {
        ("Scan",       "Index",          "📷", "Test scan hàng loạt",  "bg-gradient-primary"),
        ("Production2", "Index",          "🏭", "Sản xuất",             "bg-gradient-warning"),
        ("Qc",         "Index",          "✅", "QC",                   "bg-gradient-success"),
        ("Report",     "Index",          "📊", "Báo cáo",              "bg-gradient-info"),
        ("Account",    "ChangePassword", "🔑", "Đổi mật khẩu",         "bg-gradient-danger"),
    };
}

<div class="row">
    <div class="col-12">
        <div class="card bg-gradient-dark overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-center text-center text-sm-start gap-3">
                    <div class="icon icon-shape icon-lg bg-white shadow text-center border-radius-xl d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="material-symbols-rounded text-dark" style="font-size:1.85rem;" aria-hidden="true">person</i>
                    </div>
                    <div class="flex-grow-1">
                        <p class="text-white opacity-8 text-sm mb-1">@greeting,</p>
                        <h5 class="text-white mb-2 vni-name">@Model?.FullName</h5>
                        <div class="d-flex flex-wrap justify-content-center justify-content-sm-start gap-2">
                            <span class="badge bg-white text-dark d-inline-flex align-items-center gap-1 px-3 py-2">
                                <i class="material-symbols-rounded text-sm" aria-hidden="true">badge</i>@Model?.EmpCd
                            </span>
                            <span class="badge bg-white text-dark d-inline-flex align-items-center gap-1 px-3 py-2">
                                <i class="material-symbols-rounded text-sm" aria-hidden="true">apartment</i>@Model?.DeptNm
                            </span>
                            @if (!string.IsNullOrEmpty(Model?.LineCd))
                            {
                                <span class="badge bg-white text-dark d-inline-flex align-items-center gap-1 px-3 py-2">
                                    <i class="material-symbols-rounded text-sm" aria-hidden="true">precision_manufacturing</i>Line @Model.LineCd
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 mb-2">
        <p class="text-secondary text-sm mb-0">Truy cập nhanh</p>
    </div>
    @foreach (var link in quickLinks)
    {
        <div class="col-6 col-md-3 mb-4">
            <a asp-controller="@link.Controller" asp-action="@link.Action" class="text-decoration-none">
                <div class="card h-100 quick-tile">
                    <div class="card-body p-3 text-center">
                        <div class="@link.Gradient shadow border-radius-lg mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:64px;height:64px;font-size:2.1rem;line-height:1;" aria-hidden="true">
                            @link.Emoji
                        </div>
                        <p class="text-sm mb-0 text-dark font-weight-bold">@link.Title</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
