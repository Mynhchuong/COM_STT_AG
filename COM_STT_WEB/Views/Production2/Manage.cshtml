@{
    ViewData["Title"] = "Quản lý Set In/Out - Sản xuất";
}

<style>
    #ordNoInput {
        font-size: 1.1rem;
        font-weight: 700;
        min-height: 48px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        max-width: 280px;
    }

    .pivot-table-wrap {
        overflow: auto;
        max-height: 72vh;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    #pivotTable {
        border-collapse: separate;
        border-spacing: 0;
        white-space: nowrap;
        font-size: 0.82rem;
    }

    #pivotTable th,
    #pivotTable td {
        padding: 0.4rem 0.5rem;
        border-bottom: 1px solid #e9ecef;
        border-right: 1px solid #f1f3f5;
        text-align: right;
        min-width: 44px;
    }
    #pivotTable td.size-col-zero {
        color: #adb5bd;
    }

    #pivotTable thead th {
        position: sticky;
        top: 0;
        background: #344767;
        color: #fff;
        z-index: 3;
        text-align: center;
        font-weight: 700;
    }

    /* Cột meta + TỔNG bên trái luôn dính lại khi cuộn ngang (TỔNG đặt cạnh cột Loại cho tiện xem,
       không phải cuộn hết bảng mới thấy) */
    #pivotTable th.meta-col,
    #pivotTable td.meta-col,
    #pivotTable th.total-col,
    #pivotTable td.total-col {
        position: sticky;
        background: #fff;
        z-index: 2;
        font-weight: 700;
    }
    #pivotTable th.meta-col {
        text-align: left;
    }
    #pivotTable thead th.meta-col,
    #pivotTable thead th.total-col {
        z-index: 4;
        background: #344767;
    }
    #pivotTable td.meta-col.action-input { color: #2dce89; }
    #pivotTable td.meta-col.action-output { color: #1a73e8; }
    #pivotTable td.meta-col.action-balance { color: #344767; }

    #pivotTable tr.row-input td { background: rgba(45, 206, 137, 0.06); }
    #pivotTable tr.row-output td { background: rgba(26, 115, 232, 0.06); }
    #pivotTable tr.row-balance td {
        background: rgba(52, 71, 103, 0.08);
        font-weight: 800;
        border-top: 2px solid #344767;
    }
    #pivotTable tr.row-balance td.neg { color: #f5365c; }
    #pivotTable tr.row-balance td.pos-zero { color: #344767; }

    #pivotTable td.total-col,
    #pivotTable th.total-col {
        border-right: 2px solid #344767;
        font-weight: 800;
    }
</style>

<div class="row">
    <div class="col-12 mb-3">
        <div class="card bg-gradient-danger border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-danger shadow border-radius-md d-flex align-items-center justify-content-center">
                        🔎
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">QUẢN LÝ SET IN/OUT</h5>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        🏠 Trang chủ
                    </a>
                    <a asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        ⬅️ Set In/Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-3">
        <div class="card border-radius-lg">
            <div class="card-body p-3 d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label for="ordNoInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Số Order (C_ORD_NO)</label>
                    <input type="text" id="ordNoInput" class="form-control" placeholder="VD: 410766" autocomplete="off" />
                </div>
                <button type="button" id="btnFindOrder" class="btn bg-gradient-danger mb-0 px-4 d-flex align-items-center gap-1" style="min-height:48px;">
                    🔍 Tìm
                </button>
                <span id="pivotStatus" class="text-sm text-secondary ms-2"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-radius-lg">
            <div class="card-body p-3">
                <div class="pivot-table-wrap">
                    <table id="pivotTable" class="mb-0 w-100" style="display:none;">
                        <thead>
                            <tr id="pivotHeaderRow"></tr>
                        </thead>
                        <tbody id="pivotBody"></tbody>
                    </table>
                    <div id="pivotEmpty" class="text-center py-5 text-secondary text-sm">
                        📊
                        <p class="mb-0">Nhập số Order rồi bấm Tìm để xem bảng số lượng theo size.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/production2-manage.js" asp-append-version="true"></script>
}
