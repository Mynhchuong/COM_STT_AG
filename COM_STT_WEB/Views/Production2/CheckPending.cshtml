@{
    ViewData["Title"] = "Kiểm tra Pending - Sản xuất";
}

<style>
    :root {
        --border-radius-custom: 16px;
    }

    body {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
    }

    #scan-reader {
        border: 4px solid #f5365c;
        border-radius: 16px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        max-width: 420px;
        max-height: 300px;
        position: relative;
    }
    #scan-reader video,
    #scan-reader canvas {
        width: 100% !important;
        max-height: 300px;
        object-fit: cover;
    }
    #scan-reader.flash-success {
        border-color: #2dce89 !important;
        box-shadow: 0 0 24px rgba(45, 206, 137, 0.85) !important;
    }
    #scan-reader.flash-error {
        border-color: #f5365c !important;
        box-shadow: 0 0 24px rgba(245, 54, 92, 0.85) !important;
    }

    #cardNoInput {
        font-size: 1.4rem !important;
        font-weight: 800 !important;
        min-height: 64px !important;
        border-radius: var(--border-radius-custom) !important;
        border: 2.5px solid #f5365c !important;
        padding: 10px 16px !important;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        background-color: #fff !important;
        text-align: center;
    }
    #cardNoInput:focus {
        border-color: #b21f3e !important;
        box-shadow: 0 0 0 4px rgba(245,54,92,0.25) !important;
        outline: none;
    }

    #checkStatusMsg {
        font-size: 1rem;
        min-height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.3s ease;
    }
</style>

<div class="row">
    <div class="col-12 mb-3">
        <div class="card bg-gradient-danger border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-danger shadow border-radius-md d-flex align-items-center justify-content-center">
                        🔎
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">KIỂM TRA PENDING</h5>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        🏠 Trang chủ
                    </a>
                    <a asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        ⬅️ Set In/Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-6 mx-auto">
        <div class="card border-radius-lg">
            <div class="card-header pb-0 ps-3 pt-3">
                <h6 class="mb-0 text-sm font-weight-bolder d-flex align-items-center gap-2">
                    🔎 Quét mã PCard để kiểm tra
                </h6>
                <p class="text-xs text-secondary mb-0">Dùng Camera hoặc súng bắn mã vạch cầm tay quét thẻ — hệ thống sẽ tự động mở trang Chờ Set In (v2) của basket tương ứng để xem còn thiếu part nào chưa nhận đủ.</p>
            </div>
            <div class="card-body p-3 text-center">

                <!-- 1. CHỨC NĂNG QUÉT CAMERA -->
                <div class="mb-4">
                    <div id="idle-section" class="py-4 bg-light border-radius-lg border border-dashed border-2">
                        📸
                        <p class="text-secondary text-xs mb-3">Bấm nút bên dưới để mở Camera quét mã vạch / QR</p>
                        <button id="btn-start-scan" type="button" class="btn bg-gradient-primary btn-lg px-4 py-3 mb-0 d-inline-flex align-items-center gap-2" style="border-radius:14px; min-height:56px; font-weight:800;">
                            📷 BẮT ĐẦU QUÉT CAMERA
                        </button>
                    </div>

                    <div id="scan-section" class="d-none">
                        <div id="scan-reader" class="mx-auto bg-black"></div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button id="btn-stop-scan" type="button" class="btn btn-outline-danger mb-0 d-inline-flex align-items-center gap-1 px-4 py-2" style="border-radius:12px;">
                                📵 Tắt Camera
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. SÚNG BẮN MÃ VẠCH PDA HOẶC NHẬP TAY -->
                <div class="border-top pt-3 text-start">
                    <label for="cardNoInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Hoặc Bắn súng mã vạch PDA / Nhập tay</label>
                    <input type="text" id="cardNoInput" class="form-control mb-2" placeholder="BẮN MÃ PCARD VÀO ĐÂY..." autocomplete="off" inputmode="text" />
                </div>

                <div id="checkStatusMsg" class="text-secondary"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/global-function.js" asp-append-version="true"></script>
    <script src="~/js/pages/production2-checkpending.js" asp-append-version="true"></script>
}
