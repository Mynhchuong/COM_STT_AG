@{
    ViewData["Title"] = "Chờ Set In (v2) - Sản xuất";
    var basketId = ViewData["BasketId"] as int?;
}

<style>
    #basketDetailTable {
        border-collapse: separate;
        border-spacing: 0;
        white-space: nowrap;
        font-size: 0.95rem;
    }
    #basketDetailTable th, #basketDetailTable td {
        padding: 0.65rem 0.7rem;
        border-bottom: 1px solid #e9ecef;
        text-align: center;
    }
    #basketDetailTable thead th {
        background: #344767;
        color: #fff;
        font-weight: 700;
    }
    #basketDetailTable td.col-part-name { text-align: left; white-space: normal; }
    #basketDetailTable td.col-meta { text-align: left; white-space: normal; color: #67748e; font-size: 0.85rem; }
    #basketDetailTable tr.row-done td { background: rgba(45, 206, 137, 0.06); }
    #basketDetailTable tr.row-partial td { background: rgba(251, 99, 64, 0.05); }
    #basketDetailTable tr.row-out-locked td { background: rgba(26, 115, 232, 0.06); }

    /* Màn hình nhỏ (điện thoại): bảng chuyển thành danh sách thẻ xếp dọc — mỗi part 1 khối,
       nhãn cột hiện bên trái nhờ data-label, nút số lượng to hơn để bấm chính xác bằng ngón tay. */
    @@media (max-width: 767.98px) {
        #basketDetailTable, #basketDetailTable tbody, #basketDetailTable tr, #basketDetailTable td {
            display: block;
            width: 100%;
        }
        #basketDetailTable thead { display: none; }
        #basketDetailTable tr {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            margin-bottom: 0.65rem;
            padding: 0.6rem 0.85rem;
            box-shadow: 0 1px 5px rgba(0,0,0,0.06);
        }
        #basketDetailTable tr.row-done { border-color: rgba(45, 206, 137, 0.5); }
        #basketDetailTable tr.row-partial { border-color: rgba(251, 99, 64, 0.5); }
        #basketDetailTable tr.row-out-locked { border-color: rgba(26, 115, 232, 0.5); }
        #basketDetailTable td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border-bottom: 1px dashed #f1f3f5;
            padding: 0.4rem 0;
            text-align: right;
            white-space: normal;
        }
        #basketDetailTable td:last-child { border-bottom: none; }
        #basketDetailTable td::before {
            content: attr(data-label);
            font-weight: 700;
            color: #8898aa;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            text-align: left;
            flex-shrink: 0;
        }
        #basketDetailTable td.col-part-name {
            display: block;
            text-align: left;
            font-size: 1rem;
            padding-bottom: 0.5rem;
        }
        #basketDetailTable td.col-part-name::before { display: none; }
        #basketDetailTable td.col-qty .qty-btn {
            min-width: 92px;
            min-height: 50px;
            font-size: 1.15rem;
        }

        /* Banner cam đầu trang: thu nhỏ icon/chữ/nút để đỡ chiếm màn hình dọc trên điện thoại. */
        #pageHeaderCard .card-body { padding: 0.75rem 0.9rem; }
        #pageHeaderCard .icon.icon-shape { width: 34px; height: 34px; min-width: 34px; font-size: 1.05rem; }
        #pageHeaderCard h5 { font-size: 0.95rem; }
        #pageHeaderCard .btn-sm { padding: 0.4rem 0.65rem; font-size: 0.72rem; min-height: 0 !important; }

        /* Khung tìm kiếm: chuyển label+input sang dạng lưới 2 cột gọn thay vì bị bể dòng như flex-wrap. */
        #searchCard .card-body {
            display: grid;
            grid-template-columns: 92px 1fr;
            align-items: center;
            gap: 0.5rem 0.6rem;
            padding: 0.75rem 0.9rem;
        }
        #searchCard label { font-size: 0.75rem; margin: 0; }
        #searchCard input { max-width: 100% !important; width: 100%; }
        #searchCard #btnFindBasket,
        #searchCard #basketStatus {
            grid-column: 1 / -1;
        }
        #searchCard #btnFindBasket { width: 100%; justify-content: center; }
        #searchCard #basketStatus { margin: 0; }

        /* Thẻ thông tin PCard (header): giảm padding/cỡ chữ, badge nhỏ gọn lại. */
        .header-info-card .card-body { padding: 0.7rem 0.9rem; }
        .header-info-card strong.text-md { font-size: 0.92rem; }
        .header-info-card .badge { font-size: 0.62rem; padding: 0.35rem 0.55rem; }
        .header-info-card .text-xs { font-size: 0.72rem; line-height: 1.5; }
    }

    .qty-btn {
        display: inline-block;
        min-width: 60px;
        min-height: 40px;
        border-radius: 8px;
        border: 2px dashed #cbd5e1;
        background: #f8f9fa;
        color: #adb5bd;
        font-weight: 700;
        cursor: pointer;
    }
    .qty-btn.has-value {
        border: 2px solid #2dce89;
        background: rgba(45, 206, 137, 0.12);
        color: #2dce89;
    }
    /* Đã nhận 1 phần (chưa đủ) — cam, phân biệt rõ với đã nhận ĐỦ (xanh), tránh công nhân
       nhìn nhầm "có số" là "xong" vì cả 2 trước đây dùng chung 1 màu xanh. */
    .qty-btn.partial {
        border: 2px solid #fb6340;
        background: rgba(251, 99, 64, 0.12);
        color: #fb6340;
    }
    .qty-btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
        border-style: solid;
    }

    #basketOutBanner, #basketProcessOutBanner {
        display: none;
    }
    #basketOutBanner.show, #basketProcessOutBanner.show {
        display: flex;
    }
    #basketProcessOutBanner { margin-top: 0.5rem; }

    #numpadOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    #numpadOverlay.show { display: flex; }
    .numpad-box {
        background: #fff;
        border-radius: 16px;
        padding: 1.25rem;
        width: 320px;
        max-width: 92vw;
        box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    }
    .numpad-display {
        text-align: center;
        font-size: 2.2rem;
        font-weight: 800;
        color: #344767;
        padding: 0.5rem 0;
        margin: 0.75rem 0;
        border-bottom: 2px solid #e9ecef;
        min-height: 3.2rem;
    }
    .numpad-error { color: #f5365c; font-size: 0.85rem; text-align: center; min-height: 1.2rem; }
    #numpadFull { min-height: 48px; font-weight: 700; border-radius: 10px; border: none; margin-bottom: 0.75rem; }
    .numpad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
    .numpad-grid button { min-height: 56px; font-size: 1.3rem; font-weight: 700; border-radius: 10px; border: 1px solid #e9ecef; background: #f8f9fa; color: #344767; }
    .numpad-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
    .numpad-actions button { flex: 1; min-height: 48px; font-weight: 700; border-radius: 10px; border: none; }

    /* Popup xác nhận tuỳ chỉnh — KHÔNG dùng confirm()/alert() gốc của trình duyệt (giao diện xấu,
       không đồng bộ style, một số trình duyệt/webview trên máy quét PDA còn chặn hẳn). */
    #confirmOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1060;
        align-items: center;
        justify-content: center;
    }
    #confirmOverlay.show { display: flex; }
    .confirm-box {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        width: 340px;
        max-width: 92vw;
        box-shadow: 0 10px 40px rgba(0,0,0,0.25);
        text-align: center;
    }
    .confirm-box .confirm-icon { font-size: 2.2rem; }
    .confirm-box .confirm-message { font-size: 0.95rem; color: #344767; font-weight: 600; margin: 0.75rem 0 1.1rem; }
    .confirm-actions { display: flex; gap: 0.5rem; }
    .confirm-actions button { flex: 1; min-height: 48px; font-weight: 700; border-radius: 10px; border: none; }

    #saveLoadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,0.55);
        z-index: 2000;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.75rem;
    }
    #saveLoadingOverlay.show { display: flex; }
    #saveLoadingOverlay .spinner-border { width: 3rem; height: 3rem; }
</style>

<div class="row">
    <div class="col-12 mb-3">
        <div id="pageHeaderCard" class="card bg-gradient-warning border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-warning shadow border-radius-md d-flex align-items-center justify-content-center">
                        ⏳
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">CHỜ SET IN (v2)</h5>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        🏠 Trang chủ
                    </a>
                    <a asp-action="SetIn" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        📷 Set In
                    </a>
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="col-12 mb-3">
        <div id="searchCard" class="card border-radius-lg">
            <div class="card-body p-3 d-flex flex-wrap align-items-center gap-2">
                <label class="text-xs font-weight-bolder text-dark mb-0">Basket ID:</label>
                <input type="text" id="basketIdInput" class="form-control" placeholder="VD: 21" autocomplete="off" style="max-width:120px; min-height:38px;" value="@basketId" />
                <label class="text-xs font-weight-bolder text-dark mb-0 ms-2">hoặc mã PCard:</label>
                <input type="text" id="cardNoInput" class="form-control" placeholder="VD: PAB6714002494" autocomplete="off" style="max-width:200px; min-height:38px; text-transform:uppercase;" />
                <button type="button" id="btnFindBasket" class="btn bg-gradient-warning mb-0 px-3 d-flex align-items-center gap-1" style="min-height:38px;">
                    🔍 Tìm
                </button>
                <span id="basketStatus" class="text-sm text-secondary ms-2"></span>
            </div>
        </div>
    </div>

    <div class="col-12 mb-2">
        <div id="basketOutBanner" class="alert bg-gradient-secondary text-white mb-0 align-items-center gap-2 py-2">
            🔒 Basket này đã Set Out — chỉ xem, không sửa số lượng nhận được nữa.
        </div>
        <div id="basketProcessOutBanner" class="alert bg-gradient-warning text-white mb-0 align-items-center gap-2 py-2">
            🔶 Basket này đang Out dở (1 số part đã Out) — các part chưa Out vẫn nhận hàng bình thường.
        </div>
    </div>

    <div class="col-12 mb-3" id="headerSection" style="display:none;">
        <div class="row" id="headerCards"></div>
    </div>

    <div class="col-12">
        <div class="card border-radius-lg">
            <div class="card-header pb-2 ps-3 pt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h6 class="mb-0 text-sm font-weight-bolder">Số lượng cần chuẩn bị theo Part</h6>
                <button type="button" id="btnMarkAllDone" class="btn bg-gradient-success btn-sm mb-0 d-flex align-items-center gap-1" disabled>
                    ✅ Nhận đủ tất cả
                </button>
            </div>
            <div class="card-body p-2 p-md-3">
                <div style="overflow:auto; max-height:70vh;">
                    <table id="basketDetailTable" class="mb-0 w-100" style="display:none;">
                        <thead>
                            <tr>
                                <th class="col-part-name">Part No / Tên Part</th>
                                <th class="col-meta">PO / Style / Size</th>
                                <th>Cần</th>
                                <th>Đã nhận</th>
                                <th>Còn lại</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="detailBody"></tbody>
                    </table>
                    <div id="detailEmpty" class="text-center py-5 text-secondary text-sm">
                        📊
                        <p class="mb-0">Nhập Basket ID hoặc quét/nhập mã PCard rồi bấm Tìm.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="numpadOverlay">
    <div class="numpad-box">
        <div class="numpad-title font-weight-bold text-dark" id="numpadTitle">Part</div>
        <div class="numpad-display" id="numpadDisplay">0</div>
        <div class="numpad-error" id="numpadError"></div>
        <button type="button" id="numpadFull" class="btn bg-gradient-success mb-0 w-100 d-flex align-items-center justify-content-center gap-1">
            ✅ Nhận đủ (<span id="numpadFullQty">0</span>)
        </button>
        <div class="numpad-grid">
            <button type="button" data-digit="1">1</button>
            <button type="button" data-digit="2">2</button>
            <button type="button" data-digit="3">3</button>
            <button type="button" data-digit="4">4</button>
            <button type="button" data-digit="5">5</button>
            <button type="button" data-digit="6">6</button>
            <button type="button" data-digit="7">7</button>
            <button type="button" data-digit="8">8</button>
            <button type="button" data-digit="9">9</button>
            <button type="button" id="numpadClear">C</button>
            <button type="button" data-digit="0">0</button>
            <button type="button" id="numpadBackspace">⌫</button>
        </div>
        <div class="numpad-actions">
            <button type="button" id="numpadCancel" class="btn bg-gradient-secondary mb-0">Huỷ</button>
            <button type="button" id="numpadSave" class="btn bg-gradient-success mb-0">Lưu</button>
        </div>
    </div>
</div>

<div id="confirmOverlay">
    <div class="confirm-box">
        <div class="confirm-icon">❓</div>
        <div class="confirm-message" id="confirmMessage">Xác nhận?</div>
        <div class="confirm-actions">
            <button type="button" id="confirmCancel" class="btn bg-gradient-secondary mb-0">Huỷ</button>
            <button type="button" id="confirmOk" class="btn bg-gradient-success mb-0">Xác nhận</button>
        </div>
    </div>
</div>

<div id="saveLoadingOverlay">
    <div class="spinner-border text-warning" role="status"></div>
    <div class="text-dark font-weight-bold">Đang lưu...</div>
</div>

@section Scripts {
    <script>
        window.pending2Config = { initialBasketId: @Html.Raw(basketId.HasValue ? basketId.Value.ToString() : "null") };
    </script>
    <script src="~/assets/js/global-function.js" asp-append-version="true"></script>
    <script src="~/js/pages/production2-pending2.js" asp-append-version="true"></script>
}
