@{
    ViewData["Title"] = "Xem Log - Sản xuất";
}

<style>
    .log-item {
        background: #fff;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 10px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .log-item .badge-action-in { background: #2dce89; }
    .log-item .badge-action-out { background: #1a73e8; }

    #filterScanReader {
        border: 4px solid #344767;
        border-radius: 14px;
        overflow: hidden;
        max-width: 420px;
        max-height: 280px;
        margin: 0 auto;
    }
    #filterScanReader video,
    #filterScanReader canvas {
        width: 100% !important;
        max-height: 280px;
        object-fit: cover;
    }
</style>

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12 mb-3">
        <div class="card bg-gradient-dark border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-dark shadow border-radius-md d-flex align-items-center justify-content-center">
                        <i class="material-symbols-rounded" style="font-size:1.8rem;">receipt_long</i>
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">XEM LOG</h5>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        <i class="material-symbols-rounded">home</i>Trang chủ
                    </a>
                    <a asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        <i class="material-symbols-rounded">arrow_back</i>Set In/Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-3">
        <div class="card border-radius-lg">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                    <div>
                        <label for="logDateInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Ngày</label>
                        <input type="date" id="logDateInput" class="form-control" style="min-height:38px; max-width:170px;" />
                    </div>
                    <div>
                        <label for="logActionFilter" class="text-xs font-weight-bolder text-dark mb-1 d-block">Loại</label>
                        <select id="logActionFilter" class="form-control" style="min-height:38px; max-width:150px;">
                            <option value="">Tất cả (IN/OUT)</option>
                            <option value="INPUT">Chỉ SET IN</option>
                            <option value="OUTPUT">Chỉ SET OUT</option>
                        </select>
                    </div>
                </div>

                <label class="text-xs font-weight-bolder text-dark mb-1 d-block">Lọc nhanh (quét PCard hoặc gõ Style/Order/PO/NV...)</label>
                <div class="d-flex flex-wrap gap-2">
                    <input type="text" id="logFilterInput" class="form-control" placeholder="Gõ để lọc, hoặc bấm nút quét..." autocomplete="off" style="max-width: 320px;" />
                    <button type="button" id="btnScanFilter" class="btn btn-outline-dark mb-0 d-flex align-items-center gap-1">
                        <i class="material-symbols-rounded">qr_code_scanner</i>Quét PCard
                    </button>
                    <button type="button" id="btnClearFilter" class="btn btn-outline-secondary mb-0 d-none">
                        <i class="material-symbols-rounded">close</i>Xoá lọc
                    </button>
                </div>
                <div id="filterScanArea" class="d-none mt-3">
                    <div id="filterScanReader" class="bg-black"></div>
                    <div class="text-center mt-2">
                        <button type="button" id="btnCancelFilterScan" class="btn btn-sm btn-outline-danger mb-0">Huỷ quét</button>
                    </div>
                </div>
                <div id="filterStatus" class="text-xs text-secondary mt-2"></div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-radius-lg">
            <div class="card-header pb-2 ps-3 pt-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 text-sm font-weight-bolder">Danh sách đã ghi</h6>
                <span class="badge bg-gradient-dark text-sm px-3 py-2" id="logCount">0 dòng</span>
            </div>
            <div class="card-body p-2 p-md-3">
                <div id="logListContainer" style="max-height: 640px; overflow-y: auto;">
                    <div class="text-center py-5 text-secondary text-sm" id="emptyLogMsg">
                        <i class="material-symbols-rounded text-secondary text-4xl mb-2">inbox</i>
                        <p class="mb-0">Đang tải...</p>
                    </div>
                </div>
                <div id="paginationBar" class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top d-none">
                    <button type="button" id="btnPrevPage" class="btn btn-outline-dark btn-sm mb-0 d-flex align-items-center gap-1">
                        <i class="material-symbols-rounded">chevron_left</i>Trước
                    </button>
                    <span id="pageIndicator" class="text-sm text-secondary font-weight-bold">Trang 1/1</span>
                    <button type="button" id="btnNextPage" class="btn btn-outline-dark btn-sm mb-0 d-flex align-items-center gap-1">
                        Sau<i class="material-symbols-rounded">chevron_right</i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/production2-log.js" asp-append-version="true"></script>
}
