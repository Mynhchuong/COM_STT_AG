@{
    ViewData["Title"] = "SET OUT - Sản xuất";
}

<style>
    #scan-reader {
        border: 4px solid #1a73e8;
        border-radius: 16px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        max-width: 420px;
        max-height: 300px;
        position: relative;
    }
    #scan-reader video,
    #scan-reader canvas {
        width: 100% !important;
        max-height: 300px;
        object-fit: cover;
    }
    #scan-reader.flash-success {
        border-color: #2dce89 !important;
        box-shadow: 0 0 24px rgba(45, 206, 137, 0.85) !important;
    }
    #scan-reader.flash-error {
        border-color: #f5365c !important;
        box-shadow: 0 0 24px rgba(245, 54, 92, 0.85) !important;
    }
    #cardNoInput {
        font-size: 1.1rem !important;
        font-weight: 800 !important;
        min-height: 48px !important;
        border-radius: 14px !important;
        border: 2px solid #1a73e8 !important;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
    #cardNoInput:focus {
        border-color: #0d47a1 !important;
        box-shadow: 0 0 0 4px rgba(26,115,232,0.25) !important;
        outline: none;
    }

    #basketDetailTable {
        border-collapse: separate;
        border-spacing: 0;
        white-space: nowrap;
        font-size: 0.95rem;
    }
    #basketDetailTable th, #basketDetailTable td {
        padding: 0.65rem 0.7rem;
        border-bottom: 1px solid #e9ecef;
        text-align: center;
    }
    #basketDetailTable thead th {
        background: #344767;
        color: #fff;
        font-weight: 700;
    }
    #basketDetailTable td.col-part-name { text-align: left; white-space: normal; }
    #basketDetailTable td.col-meta { text-align: left; white-space: normal; color: #67748e; font-size: 0.85rem; }
    #basketDetailTable tr.row-out td { background: rgba(45, 206, 137, 0.06); }
    #basketDetailTable tr.row-locked td { background: rgba(140, 140, 140, 0.06); color: #adb5bd; }

    .row-check {
        width: 22px;
        height: 22px;
        cursor: pointer;
        vertical-align: middle;
    }
    .row-check:disabled { cursor: not-allowed; }
    #basketDetailTable td.col-check .check-label { display: none; }

    /* Màn hình nhỏ (điện thoại): bảng chuyển thành danh sách thẻ xếp dọc — mỗi part 1 khối. */
    @@media (max-width: 767.98px) {
        #basketDetailTable, #basketDetailTable tbody, #basketDetailTable tr, #basketDetailTable td {
            display: block;
            width: 100%;
        }
        #basketDetailTable thead { display: none; }
        #basketDetailTable tr {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            margin-bottom: 0.65rem;
            padding: 0.6rem 0.85rem;
            box-shadow: 0 1px 5px rgba(0,0,0,0.06);
        }
        #basketDetailTable tr.row-out { border-color: rgba(45, 206, 137, 0.5); }
        #basketDetailTable tr.row-locked { border-color: rgba(140,140,140,0.35); }
        #basketDetailTable td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border-bottom: 1px dashed #f1f3f5;
            padding: 0.4rem 0;
            text-align: right;
            white-space: normal;
        }
        #basketDetailTable td:last-child { border-bottom: none; }
        #basketDetailTable td::before {
            content: attr(data-label);
            font-weight: 700;
            color: #8898aa;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            text-align: left;
            flex-shrink: 0;
        }
        #basketDetailTable td.col-part-name {
            display: block;
            text-align: left;
            font-size: 1rem;
            padding-bottom: 0.5rem;
        }
        #basketDetailTable td.col-part-name::before { display: none; }

        /* Ô "Chọn" đưa lên đầu thẻ, to rõ, kèm chữ giải thích — dễ bấm và dễ hiểu hơn là chỉ có
           1 ô vuông nhỏ nằm lẫn trong danh sách thông số. */
        #basketDetailTable td.col-check {
            order: -1;
            justify-content: flex-start;
            gap: 0.6rem;
            padding-bottom: 0.6rem;
            margin-bottom: 0.4rem;
            border-bottom: 1px dashed #f1f3f5;
        }
        #basketDetailTable td.col-check::before { display: none; }
        #basketDetailTable td.col-check .row-check { width: 28px; height: 28px; }
        #basketDetailTable td.col-check .check-label {
            display: inline;
            font-weight: 700;
            font-size: 0.85rem;
            color: #344767;
        }

        /* Khối chọn Nhà/Line: xếp 2 cột đều nhau cho dễ bấm, Line xuống hàng riêng full-width. */
        #destinationSection .card-body { padding: 0.75rem 0.9rem; }
        #destinationSection > .card-body > div {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
        }
        .nha-btn { width: 100%; }
        #lineSelect:not(.d-none) { grid-column: 1 / -1; max-width: 100% !important; width: 100%; }

        #pageHeaderCard .card-body { padding: 0.75rem 0.9rem; }
        #pageHeaderCard .icon.icon-shape { width: 34px; height: 34px; min-width: 34px; font-size: 1.05rem; }
        #pageHeaderCard h5 { font-size: 0.95rem; }
        #pageHeaderCard .btn-sm { padding: 0.4rem 0.65rem; font-size: 0.72rem; min-height: 0 !important; }

        .header-info-card .card-body { padding: 0.7rem 0.9rem; }
        .header-info-card strong.text-md { font-size: 0.92rem; }
        .header-info-card .badge { font-size: 0.62rem; padding: 0.35rem 0.55rem; }
        .header-info-card .text-xs { font-size: 0.72rem; line-height: 1.5; }

        .nha-btn { min-height: 52px !important; font-size: 1rem !important; }
    }

    .nha-btn {
        min-width: 76px;
        min-height: 56px;
        font-size: 1.15rem;
        font-weight: 800;
        border-radius: 12px;
        border: 2px solid #e9ecef;
        background: #f8f9fa;
        color: #67748e;
    }
    .nha-btn.active {
        border-color: #1a73e8;
        background: rgba(26, 115, 232, 0.12);
        color: #1a73e8;
    }
    .nha-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    #confirmOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1060;
        align-items: center;
        justify-content: center;
    }
    #confirmOverlay.show { display: flex; }
    .confirm-box {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        width: 340px;
        max-width: 92vw;
        box-shadow: 0 10px 40px rgba(0,0,0,0.25);
        text-align: center;
    }
    .confirm-box .confirm-icon { font-size: 2.2rem; }
    .confirm-box .confirm-message { font-size: 0.95rem; color: #344767; font-weight: 600; margin: 0.75rem 0 1.1rem; white-space: pre-line; }
    .confirm-actions { display: flex; gap: 0.5rem; }
    .confirm-actions button { flex: 1; min-height: 48px; font-weight: 700; border-radius: 10px; border: none; }

    #saveLoadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,0.55);
        z-index: 2000;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.75rem;
    }
    #saveLoadingOverlay.show { display: flex; }
    #saveLoadingOverlay .spinner-border { width: 3rem; height: 3rem; }
</style>

<div class="row">
    <div class="col-12 mb-3">
        <div id="pageHeaderCard" class="card bg-gradient-info border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-info shadow border-radius-md d-flex align-items-center justify-content-center">
                        🚪
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">SET OUT — Ra Chuyền theo Part</h5>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        🏠 Trang chủ
                    </a>
                    <a asp-action="SetIn" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                        📷 Set In
                    </a>
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="col-12 col-md-8 col-lg-6 mx-auto mb-3">
        <div class="card border-radius-lg">
            <div class="card-header pb-0 ps-3 pt-3">
                <h6 class="mb-0 text-sm font-weight-bolder d-flex align-items-center gap-2">
                    📷 Quét mã PCard
                </h6>
                <p class="text-xs text-secondary mb-0">Dùng Camera, súng bắn mã vạch PDA, hoặc nhập tay mã PCard.</p>
            </div>
            <div class="card-body p-3 text-center">
                <div class="mb-3">
                    <div id="idle-section" class="py-4 bg-light border-radius-lg border border-dashed border-2">
                        📸
                        <p class="text-secondary text-xs mb-3">Bấm nút bên dưới để mở Camera quét mã vạch / QR</p>
                        <button id="btn-start-scan" type="button" class="btn bg-gradient-primary btn-lg px-4 py-3 mb-0 d-inline-flex align-items-center gap-2" style="border-radius:14px; min-height:56px; font-weight:800;">
                            📷 BẮT ĐẦU QUÉT CAMERA
                        </button>
                    </div>
                    <div id="scan-section" class="d-none">
                        <div id="scan-reader" class="mx-auto bg-black"></div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button id="btn-stop-scan" type="button" class="btn btn-outline-danger mb-0 d-inline-flex align-items-center gap-1 px-4 py-2" style="border-radius:12px;">
                                📵 Tắt Camera
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3 text-start">
                    <label for="cardNoInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Hoặc Bắn súng mã vạch PDA / Nhập tay</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="cardNoInput" class="form-control" placeholder="VD: PAB6714002494" autocomplete="off" inputmode="text" />
                        <button type="button" id="btnFindBasket" class="btn bg-gradient-info mb-0 px-3" style="min-height:48px;">
                            🔍 Tìm
                        </button>
                    </div>
                </div>

                <div id="basketStatus" class="text-sm text-secondary mt-2"></div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-3" id="headerSection" style="display:none;">
        <div class="row" id="headerCards"></div>
    </div>

    <div class="col-12 mb-3" id="destinationSection" style="display:none;">
        <div class="card border-radius-lg">
            <div class="card-body p-3">
                <label class="text-xs font-weight-bolder text-dark mb-2 d-block">Out cho Nhà nào? (áp dụng cho các part đã tick bên dưới)</label>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn nha-btn" data-nha="A">NHÀ A</button>
                    <button type="button" class="btn nha-btn" data-nha="B">NHÀ B</button>
                    <button type="button" class="btn nha-btn" data-nha="C">NHÀ C</button>
                    <button type="button" class="btn nha-btn" data-nha="E">NHÀ E</button>
                    <select id="lineSelect" class="form-control d-none" style="max-width:160px; min-height:44px;">
                        <option value="">-- Chọn Line --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-radius-lg">
            <div class="card-header pb-2 ps-3 pt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h6 class="mb-0 text-sm font-weight-bolder">Chi tiết Part trong Basket</h6>
                <button type="button" id="btnConfirmOut" class="btn bg-gradient-info btn-sm mb-0 d-flex align-items-center gap-1" disabled>
                    🚪 Xác nhận Out
                </button>
            </div>
            <div class="card-body p-2 p-md-3">
                <div style="overflow:auto; max-height:70vh;">
                    <table id="basketDetailTable" class="mb-0 w-100" style="display:none;">
                        <thead>
                            <tr>
                                <th style="width:44px;">Chọn</th>
                                <th class="col-part-name">Part No / Tên Part</th>
                                <th class="col-meta">PO / Style / Size</th>
                                <th>Cần</th>
                                <th>Đã nhận</th>
                                <th>Trạng thái Out</th>
                            </tr>
                        </thead>
                        <tbody id="detailBody"></tbody>
                    </table>
                    <div id="detailEmpty" class="text-center py-5 text-secondary text-sm">
                        📊
                        <p class="mb-0">Quét hoặc nhập mã PCard rồi bấm Tìm.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="confirmOverlay">
    <div class="confirm-box">
        <div class="confirm-icon">❓</div>
        <div class="confirm-message" id="confirmMessage">Xác nhận?</div>
        <div class="confirm-actions">
            <button type="button" id="confirmCancel" class="btn bg-gradient-secondary mb-0">Huỷ</button>
            <button type="button" id="confirmOk" class="btn bg-gradient-success mb-0">Xác nhận</button>
        </div>
    </div>
</div>

<div id="saveLoadingOverlay">
    <div class="spinner-border text-info" role="status"></div>
    <div class="text-dark font-weight-bold">Đang lưu...</div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/global-function.js" asp-append-version="true"></script>
    <script src="~/js/pages/production2-setout.js" asp-append-version="true"></script>
}
