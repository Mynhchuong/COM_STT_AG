@model COM_STT_WEB.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row">
    <div class="col-12 col-md-6 mx-auto">
        <div class="card">
            <div class="card-header pb-0 d-flex align-items-center gap-3">
                <div class="icon icon-shape icon-lg bg-gradient-info shadow text-center border-radius-lg d-flex align-items-center justify-content-center">
                    <i class="material-symbols-rounded text-white" style="font-size:1.75rem;" aria-hidden="true">lock_reset</i>
                </div>
                <div>
                    <h5 class="mb-0">Đổi mật khẩu</h5>
                    <p class="text-secondary text-sm mb-0">Mật khẩu mới tối đa 10 ký tự</p>
                </div>
            </div>

            <div class="card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger text-sm mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label"></label>
                        <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" autofocus />
                        <span asp-validation-for="OldPassword" class="text-danger text-sm"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" maxlength="10" />
                        <span asp-validation-for="NewPassword" class="text-danger text-sm"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" maxlength="10" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger text-sm"></span>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn bg-gradient-dark w-100 mt-3 mb-0">Đổi mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
