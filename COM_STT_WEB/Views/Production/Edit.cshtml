@model COM_STT_WEB.Models.Production.BatchRegistrationViewModel
@{
    ViewData["Title"] = $"Sửa Đợt Đăng Ký #{Model.Seq}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card my-4">
            <!-- HEADER -->
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 pe-3 ps-3 text-center">
                    <h5 class="text-white mb-0">SỬA ĐỢT SẢN XUẤT #@Model.Seq</h5>
                    <p class="text-white opacity-8 text-xs mb-0">Cập nhật Nhà máy, Chuyền và Máy móc cho đợt hiện tại</p>
                </div>
            </div>

            <!-- BODY -->
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-seq="@Model.Seq" method="post" id="registrationForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IsEdit" />
                    <input type="hidden" asp-for="Seq" />

                    <div asp-validation-summary="ModelOnly" class="text-danger text-sm mb-3"></div>

                    <!-- PLANT DROPDOWN -->
                    <div class="mb-4">
                        <div class="input-group input-group-static">
                            <label for="plant-select" class="ms-0 text-sm font-weight-bold text-dark">Nhà máy (Plant)</label>
                            <select id="plant-select" asp-for="Plant" class="form-control form-control-lg text-lg py-2">
                                <option value="B" selected="@(Model.Plant == "B" ? "selected" : null)">Plant B (Khu B)</option>
                                <option value="E" selected="@(Model.Plant == "E" ? "selected" : null)">Plant E (Khu E)</option>
                            </select>
                        </div>
                        <span asp-validation-for="Plant" class="text-danger text-xs"></span>
                    </div>

                    <!-- LINE DROPDOWN -->
                    <div class="mb-4">
                        <div class="input-group input-group-static">
                            <label for="line-select" class="ms-0 text-sm font-weight-bold text-dark">Chuyền (Line)</label>
                            <select id="line-select" asp-for="LineCode" class="form-control form-control-lg text-lg py-2">
                                <!-- Populated dynamically by javascript -->
                            </select>
                        </div>
                        <span asp-validation-for="LineCode" class="text-danger text-xs"></span>
                    </div>

                    <!-- MACHINE CODES TAGS INPUT -->
                    <div class="mb-4">
                        <label class="text-sm font-weight-bold text-dark mb-1">Mã Máy (Machine Codes)</label>
                        <div class="d-flex flex-wrap gap-2 mb-2" id="machineTagsContainer">
                            <!-- Machine tag badges will appear here -->
                        </div>
                        <div class="d-flex gap-2">
                            <div class="input-group input-group-outline flex-grow-1">
                                <input type="text" id="machineInput" placeholder="Nhập hoặc quét mã máy rồi ấn Enter" class="form-control form-control-lg text-lg" autocomplete="off" />
                            </div>
                            <button type="button" id="btnAddMachine" class="btn btn-outline-primary mb-0 px-3 d-flex align-items-center justify-content-center">
                                <i class="material-symbols-rounded">add_circle</i>
                            </button>
                        </div>
                        <input type="hidden" asp-for="MachineCode" id="hiddenMachineCode" />
                        <span asp-validation-for="MachineCode" class="text-danger text-xs"></span>
                    </div>

                    <!-- SHIFT DROPDOWN -->
                    <div class="mb-4">
                        <div class="input-group input-group-static">
                            <label for="shift-select" class="ms-0 text-sm font-weight-bold text-dark">Ca làm việc (Shift)</label>
                            <select id="shift-select" asp-for="CShift" class="form-control form-control-lg text-lg py-2">
                                <option value="SHIFT1" selected="@(Model.CShift == "SHIFT1" ? "selected" : null)">Ca 1 (Ca Sáng)</option>
                                <option value="SHIFT2" selected="@(Model.CShift == "SHIFT2" ? "selected" : null)">Ca 2 (Ca Chiều)</option>
                                <option value="SHIFT3" selected="@(Model.CShift == "SHIFT3" ? "selected" : null)">Ca 3 (Ca Đêm)</option>
                                <option value="SHIFT_HC" selected="@(Model.CShift == "SHIFT_HC" ? "selected" : null)">Ca Hành chính</option>
                            </select>
                        </div>
                        <span asp-validation-for="CShift" class="text-danger text-xs"></span>
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="text-center mt-5 d-flex gap-3 justify-content-center">
                        <a asp-action="Index" class="btn btn-lg btn-outline-secondary mb-0 w-45 py-3 text-md">
                            <i class="material-symbols-rounded align-middle me-1">arrow_back</i>Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-lg bg-gradient-primary mb-0 w-45 py-3 text-md d-flex align-items-center justify-content-center gap-1">
                            <i class="material-symbols-rounded">save</i>Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Constant lists of lines for Plant B and E
            const plantLines = {
                'B': [
                    "1-1", "1-2", "1-3", "1-4", "1-5", "1-6", "1-7", "1-8", "1-CB",
                    "2-9", "2-10", "2-11", "2-12", "2-13", "2-14", "2-15", "2-16", "2-CB",
                    "3-17", "3-18", "3-19", "3-20", "3-21", "3-22", "3-23", "3-24", "3-CB",
                    "4-25", "4-26", "4-27", "4-28", "4-29", "4-30", "4-31", "4-32", "4-CB",
                    "5-33", "5-34", "5-35", "5-36", "5-37", "5-38", "5-39", "5-40", "5-CB",
                    "6-41", "6-42", "6-43", "6-44", "6-45", "6-46", "6-47", "6-48", "6-CB",
                    "7-49", "7-50", "7-51", "7-52", "7-53", "7-54", "7-55", "7-56", "7-CB",
                    "8-57", "8-58", "8-59", "8-60", "8-61", "8-62", "8-63", "8-64", "8-CB",
                    "9-65", "9-66", "9-67", "9-68", "9-69", "9-70", "9-71", "9-72", "9-CB",
                    "10-73", "10-74", "10-75", "10-76", "10-77", "10-78", "10-79", "10-80", "10-CB",
                    "11-81", "11-82", "11-83", "11-84", "11-85", "11-86", "11-87", "11-88", "11-CB",
                    "12-89", "12-90", "12-91", "12-92", "12-93", "12-94", "12-95", "12-96", "12-CB"
                ],
                'E': [
                    "1-01", "1-02", "1-03", "1-04", "1-05", "1-06", "1-07", "1-08", "1-09", "1-10",
                    "2-01", "2-02", "2-03", "2-04", "2-05", "2-06", "2-07", "2-08", "2-09", "2-10",
                    "3-01", "3-02", "3-03", "3-04", "3-05", "3-06", "3-07", "3-08", "3-09", "3-10",
                    "4-01", "4-02", "4-03", "4-04", "4-05", "4-06", "4-07", "4-08", "4-09", "4-10",
                    "5-01", "5-02", "5-03", "5-04", "5-05", "5-06", "5-07", "5-08", "5-09", "5-10",
                    "6-01", "6-02", "6-03", "6-04", "6-05", "6-06", "6-07", "6-08", "6-09", "6-10",
                    "7-01", "7-02", "7-03", "7-04", "7-05", "7-06", "7-07", "7-08", "7-09", "7-10",
                    "8-01", "8-02", "8-03", "8-04", "8-05", "8-06", "8-07", "8-08", "8-09", "8-10",
                    "9-01", "9-02", "9-03", "9-04", "9-05", "9-06", "9-07"
                ]
            };

            const plantSelect = document.getElementById('plant-select');
            const lineSelect = document.getElementById('line-select');
            const machineInput = document.getElementById('machineInput');
            const btnAddMachine = document.getElementById('btnAddMachine');
            const machineTagsContainer = document.getElementById('machineTagsContainer');
            const hiddenMachineCode = document.getElementById('hiddenMachineCode');

            const selectedLineCode = '@Model.LineCode';
            let machineList = [];

            // Parse initial machine list if editing
            const initialMachineCode = '@Model.MachineCode';
            if (initialMachineCode) {
                machineList = initialMachineCode.split(',').map(m => m.trim()).filter(Boolean);
                renderMachineTags();
            }

            // Populate line list dropdown based on selected plant
            function populateLines(plant) {
                lineSelect.innerHTML = '';
                const lines = plantLines[plant] || [];
                lines.forEach(function (line) {
                    const opt = document.createElement('option');
                    opt.value = line;
                    opt.textContent = line;
                    if (line === selectedLineCode) {
                        opt.selected = true;
                    }
                    lineSelect.appendChild(opt);
                });
            }

            // Add machine tag
            function addMachineCode() {
                const code = machineInput.value.trim().toUpperCase();
                if (!code) return;

                if (!machineList.includes(code)) {
                    machineList.push(code);
                    renderMachineTags();
                }
                machineInput.value = '';
                machineInput.focus();
            }

            // Render tag list UI
            function renderMachineTags() {
                machineTagsContainer.innerHTML = '';
                machineList.forEach(function (code) {
                    const tag = document.createElement('span');
                    tag.className = 'badge bg-gradient-primary d-inline-flex align-items-center gap-1 py-2 px-3 text-sm border-radius-lg shadow';
                    tag.innerHTML = code + ' <i class="material-symbols-rounded cursor-pointer ms-1 text-xs" style="font-size:14px;" data-code="' + code + '">close</i>';
                    
                    tag.querySelector('i').addEventListener('click', function () {
                        removeMachineCode(code);
                    });
                    
                    machineTagsContainer.appendChild(tag);
                });
                
                hiddenMachineCode.value = machineList.join(', ');
            }

            // Remove machine tag
            function removeMachineCode(code) {
                machineList = machineList.filter(m => m !== code);
                renderMachineTags();
            }

            // Handle Plant change
            plantSelect.addEventListener('change', function () {
                populateLines(plantSelect.value);
            });

            // Prevent form submit on pressing enter inside machine input
            machineInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addMachineCode();
                }
            });

            // Add button click
            btnAddMachine.addEventListener('click', addMachineCode);

            // Populate lines initially
            populateLines(plantSelect.value);
        });
    </script>
}
