@model COM_STT_WEB.Models.Production.ProductionIndexViewModel
@{
    ViewData["Title"] = "Phân hệ Sản xuất";
}

@functions {
    string FormatDGather(string? dGather)
    {
        if (string.IsNullOrEmpty(dGather) || dGather.Length < 14) return dGather ?? "";
        return $"{dGather.Substring(8, 2)}:{dGather.Substring(10, 2)} ({dGather.Substring(6, 2)}/{dGather.Substring(4, 2)})";
    }
}

<style>
    :root {
        --touch-target-height: 52px;
        --border-radius-custom: 14px;
    }

    body {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
    }

    /* Filter Form Elements */
    .mobile-filter-input {
        min-height: 52px !important;
        font-size: 1rem !important;
        font-weight: 600 !important;
        border-radius: var(--border-radius-custom) !important;
        border: 2px solid #dee2e6 !important;
        padding: 8px 14px !important;
        background-color: #fff !important;
    }
    .mobile-filter-input:focus {
        border-color: #1a73e8 !important;
        box-shadow: 0 0 0 3px rgba(26,115,232,0.18) !important;
        outline: none;
    }

    /* Mobile Card Component */
    .mobile-batch-index-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 12px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .mobile-batch-index-card:active {
        transform: scale(0.98);
    }
    .mobile-batch-index-card.status-open {
        border-left: 5px solid #2dce89;
    }
    .mobile-batch-index-card.status-done {
        border-left: 5px solid #6c757d;
    }

    .shift-pill-sm {
        font-size: 0.75rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 8px;
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .desktop-index-table {
            display: none !important;
        }
        .mobile-index-cards {
            display: block !important;
        }
    }
    @@media (min-width: 769px) {
        .mobile-index-cards {
            display: none !important;
        }
        .desktop-index-table {
            display: table !important;
        }
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card my-2 my-md-4 border-radius-lg">
            <!-- HEADER -->
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-3 pe-3 ps-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="icon icon-shape icon-md bg-white shadow text-center border-radius-md d-flex align-items-center justify-content-center flex-shrink-0">
                            <i class="material-symbols-rounded text-primary" style="font-size:1.6rem;">precision_manufacturing</i>
                        </div>
                        <div>
                            <h6 class="text-white text-capitalize ps-1 mb-0 font-weight-bold">Quản lý đợt kiểm lỗi sản xuất</h6>
                            <p class="text-white opacity-8 text-xs mb-0 ps-1">Danh sách đợt đăng ký và quét mã PCard</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Create" class="btn bg-gradient-dark mb-0 d-flex align-items-center justify-content-center gap-2 py-3 px-4" style="border-radius:12px; font-weight:800; font-size:0.95rem;">
                            <i class="material-symbols-rounded" style="font-size:22px;">add_circle</i>ĐĂNG KÝ MỚI
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white mb-0 d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width:48px; height:48px; border-radius:12px;" title="Về trang chủ">
                            <i class="material-symbols-rounded" style="font-size:22px;">home</i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- BODY -->
            <div class="card-body px-3 px-md-4 pb-2">
                <!-- ALERTS -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible text-white mx-0 my-2" role="alert" style="border-radius:12px;">
                        <span class="text-sm font-weight-bold">@TempData["SuccessMessage"]</span>
                        <button type="button" class="btn-close text-lg py-3 opacity-10" data-bs-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible text-white mx-0 my-2" role="alert" style="border-radius:12px;">
                        <span class="text-sm font-weight-bold">@TempData["ErrorMessage"]</span>
                        <button type="button" class="btn-close text-lg py-3 opacity-10" data-bs-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <!-- FILTERS -->
                <form method="get" class="my-3">
                    <div class="row align-items-end g-2 g-md-3">
                        <div class="col-6 col-md-4 col-lg-3">
                            <label for="date-input" class="text-xs text-uppercase font-weight-bolder text-secondary mb-1">Chọn ngày</label>
                            <input type="date" id="date-input" name="date" class="form-control mobile-filter-input" value="@Model.DateFilter" />
                        </div>
                        <div class="col-6 col-md-4 col-lg-3">
                            <label for="status-select" class="text-xs text-uppercase font-weight-bolder text-secondary mb-1">Trạng thái</label>
                            <select id="status-select" name="status" class="form-control mobile-filter-input">
                                <option value="N" selected="@(Model.StatusFilter == "N" ? "selected" : null)">Đang mở (Chờ quét)</option>
                                <option value="Y" selected="@(Model.StatusFilter == "Y" ? "selected" : null)">Đã hoàn tất</option>
                                <option value="ALL" selected="@(Model.StatusFilter == "ALL" ? "selected" : null)">Tất cả trạng thái</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4 col-lg-2">
                            <button type="submit" class="btn bg-gradient-primary w-100 mb-0 d-inline-flex align-items-center justify-content-center gap-1 font-weight-bold" style="min-height:52px; border-radius:14px; font-size:1rem;">
                                <i class="material-symbols-rounded">filter_list</i>LỌC DỮ LIỆU
                            </button>
                        </div>
                    </div>
                </form>

                <!-- VIEW 1: DESKTOP TABLE VIEW (>= 769px) -->
                <div class="table-responsive p-0 desktop-index-table">
                    <table class="table align-items-center mb-0">
                        <thead>
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">SEQ</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Nhà máy / Chuyền / Ca</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Danh sách Máy</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Styles / Orders</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">SL Quét / Kế hoạch</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Ngày tạo</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Trạng thái</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Batches.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <p class="text-secondary text-sm mb-0">Không tìm thấy đợt đăng ký nào trong ngày này.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var b in Model.Batches)
                                {
                                    <tr>
                                        <!-- SEQ -->
                                        <td class="align-middle text-center">
                                            <span class="text-dark text-xs font-weight-bold">#@b.Seq</span>
                                        </td>
                                        <!-- PLANT/LINE/SHIFT -->
                                        <td class="align-middle">
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-sm font-weight-bold">Chuyền @b.LineCode</h6>
                                                <p class="text-xs text-secondary mb-0">Plant @b.Plant · @(b.CShift == "SHIFT_HC" ? "Hành chính" : b.CShift?.Replace("SHIFT", "Ca "))</p>
                                            </div>
                                        </td>
                                        <!-- MACHINE -->
                                        <td class="align-middle">
                                            @if (!string.IsNullOrEmpty(b.MachineCode))
                                            {
                                                var machines = b.MachineCode.Split(',').Select(m => m.Trim());
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var m in machines)
                                                    {
                                                        <span class="badge badge-sm bg-gradient-secondary">@m</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-secondary italic">Không có máy</span>
                                            }
                                        </td>
                                        <!-- STYLES/ORDERS -->
                                        <td class="align-middle">
                                            <div class="d-flex flex-column justify-content-center">
                                                @if (!string.IsNullOrEmpty(b.Styles))
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                                        @foreach (var s in b.Styles.Split(',').Select(x => x.Trim()).Distinct())
                                                        {
                                                            <span class="badge badge-sm bg-gradient-info">@s</span>
                                                        }
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(b.Orders))
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var o in b.Orders.Split(',').Select(x => x.Trim()).Distinct())
                                                        {
                                                            <span class="badge badge-sm bg-gradient-warning">Order: @o</span>
                                                        }
                                                    </div>
                                                }
                                                else if (string.IsNullOrEmpty(b.Styles))
                                                {
                                                    <span class="text-xs text-secondary italic">Chưa quét thẻ nào</span>
                                                }
                                            </div>
                                        </td>
                                        <!-- QTY -->
                                        <td class="align-middle text-center">
                                            <h6 class="mb-0 text-sm">@b.TotalQty <span class="text-xs text-secondary">pcs</span></h6>
                                            <p class="text-xs text-secondary mb-0">KH: @b.OrderQty pcs</p>
                                        </td>
                                        <!-- DATE -->
                                        <td class="align-middle text-center">
                                            <span class="text-secondary text-xs">@FormatDGather(b.DGather)</span>
                                        </td>
                                        <!-- STATUS -->
                                        <td class="align-middle text-center text-sm">
                                            @if (b.Status == "Y")
                                            {
                                                <span class="badge badge-sm bg-gradient-success">Đã hoàn tất</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-sm bg-gradient-warning">Đang quét</span>
                                            }
                                        </td>
                                        <!-- ACTIONS -->
                                        <td class="align-middle text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                @if (b.Status == "N")
                                                {
                                                    <a asp-action="Scan" asp-route-seq="@b.Seq" class="btn btn-sm bg-gradient-success mb-0 d-inline-flex align-items-center gap-1 py-2 px-3" title="Vào quét PCard">
                                                        <i class="material-symbols-rounded text-sm">qr_code_scanner</i>Quét PCard
                                                    </a>
                                                    <a asp-action="Edit" asp-route-seq="@b.Seq" class="btn btn-sm btn-outline-dark mb-0 d-inline-flex align-items-center gap-1 py-2 px-3" title="Chỉnh sửa thông tin">
                                                        <i class="material-symbols-rounded text-sm">edit</i>Sửa
                                                    </a>
                                                    <form asp-action="Finish" asp-route-seq="@b.Seq" method="post" onsubmit="return confirm('Xác nhận hoàn tất đợt quét sản xuất này? Không thể sửa/quét thêm sau khi hoàn tất.');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm bg-gradient-danger mb-0 d-inline-flex align-items-center gap-1 py-2 px-3" title="Hoàn tất đợt">
                                                            <i class="material-symbols-rounded text-sm">check_circle</i>Hoàn tất
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-action="Scan" asp-route-seq="@b.Seq" class="btn btn-sm btn-outline-secondary mb-0 d-inline-flex align-items-center gap-1 py-2 px-3" title="Xem danh sách PCard">
                                                        <i class="material-symbols-rounded text-sm">visibility</i>Xem PCard
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- VIEW 2: MOBILE CARDS VIEW (< 769px) -->
                <div class="mobile-index-cards">
                    @if (!Model.Batches.Any())
                    {
                        <div class="text-center py-5 text-secondary text-sm">
                            Không tìm thấy đợt đăng ký nào trong ngày này.
                        </div>
                    }
                    else
                    {
                        foreach (var b in Model.Batches)
                        {
                            var isDone = b.Status == "Y";
                            <div class="mobile-batch-index-card @(isDone ? "status-done" : "status-open")">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-dark text-white">#@b.Seq</span>
                                            <strong class="text-md text-dark">Chuyền @b.LineCode</strong>
                                            <span class="shift-pill-sm bg-gradient-info text-white">Plant @b.Plant</span>
                                            <span class="shift-pill-sm bg-gradient-secondary text-white">@(b.CShift == "SHIFT_HC" ? "HC" : b.CShift?.Replace("SHIFT", "Ca "))</span>
                                        </div>
                                    </div>
                                    <div>
                                        @if (isDone)
                                        {
                                            <span class="badge bg-gradient-secondary text-xs">Đã hoàn tất</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-gradient-success text-xs">Đang mở</span>
                                        }
                                    </div>
                                </div>

                                <!-- Máy & Thời gian -->
                                <div class="text-xs text-secondary mb-2">
                                    Mã máy: <strong class="text-dark">@(string.IsNullOrEmpty(b.MachineCode) ? "N/A" : b.MachineCode)</strong> · <i class="material-symbols-rounded" style="font-size:14px; vertical-align:-2px;">schedule</i> @FormatDGather(b.DGather)
                                </div>

                                <!-- Styles / Orders -->
                                @if (!string.IsNullOrEmpty(b.Styles) || !string.IsNullOrEmpty(b.Orders))
                                {
                                    <div class="text-xs mb-2">
                                        @if (!string.IsNullOrEmpty(b.Styles))
                                        {
                                            <span class="badge bg-gradient-info me-1">@b.Styles</span>
                                        }
                                        @if (!string.IsNullOrEmpty(b.Orders))
                                        {
                                            <span class="badge bg-gradient-warning">Order: @b.Orders</span>
                                        }
                                    </div>
                                }

                                <!-- Số lượng & Thao tác -->
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
                                    <div>
                                        <span class="text-xs text-secondary d-block">Đã quét / Kế hoạch</span>
                                        <strong class="text-md text-primary">@b.TotalQty</strong> <span class="text-xs text-secondary">/ @b.OrderQty pcs</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        @if (!isDone)
                                        {
                                            <a asp-action="Scan" asp-route-seq="@b.Seq" class="btn btn-success mb-0 px-3 py-2 d-flex align-items-center gap-1 font-weight-bold" style="border-radius:12px; font-size:0.85rem;">
                                                <i class="material-symbols-rounded" style="font-size:18px;">qr_code_scanner</i>QUÉT PCARD
                                            </a>
                                            <a asp-action="Edit" asp-route-seq="@b.Seq" class="btn btn-outline-dark mb-0 px-2 py-2 d-flex align-items-center justify-content-center" style="border-radius:12px;" title="Sửa">
                                                <i class="material-symbols-rounded" style="font-size:18px;">edit</i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Scan" asp-route-seq="@b.Seq" class="btn btn-outline-secondary mb-0 px-3 py-2 d-flex align-items-center gap-1" style="border-radius:12px; font-size:0.85rem;">
                                                <i class="material-symbols-rounded" style="font-size:18px;">visibility</i>XEM
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
