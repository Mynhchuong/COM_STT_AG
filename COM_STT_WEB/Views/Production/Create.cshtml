@model COM_STT_WEB.Models.Production.BatchRegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký sản xuất";
}

<style>
    /* ===== MOBILE-FIRST REGISTRATION HUB STYLES ===== */
    :root {
        --touch-target-height: 56px;
        --border-radius-custom: 14px;
    }

    body {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
    }

    .reg-card {
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    /* Plant Selector Buttons */
    .plant-btn {
        flex: 1;
        min-height: 60px;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 1px;
        border-radius: var(--border-radius-custom);
        border: 3px solid transparent;
        transition: all 0.2s ease;
        cursor: pointer;
        background: #f0f2f5;
        color: #344767;
        touch-action: manipulation;
    }
    .plant-btn.active {
        background: linear-gradient(195deg, #42424a, #191919);
        color: #fff;
        border-color: #42424a;
        transform: scale(1.02);
        box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
    .plant-btn:active {
        transform: scale(0.97);
    }

    /* Shift Selector Grid */
    .shift-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }
    @@media (max-width: 576px) {
        .shift-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .shift-btn {
        min-height: 54px;
        font-size: 0.9rem;
        font-weight: 700;
        border-radius: var(--border-radius-custom);
        border: 2px solid transparent;
        transition: all 0.18s ease;
        cursor: pointer;
        background: #f0f2f5;
        color: #344767;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1.2;
    }
    .shift-btn.active {
        background: linear-gradient(195deg, #1a73e8, #0d47a1);
        color: #fff;
        border-color: #1a73e8;
        transform: scale(1.02);
        box-shadow: 0 4px 14px rgba(26,115,232,0.35);
    }
    .shift-btn:active {
        transform: scale(0.96);
    }

    /* Line Select - Prevent iOS Zoom (font-size >= 16px) */
    #line-select {
        font-size: 1.15rem;
        font-weight: 700;
        min-height: 56px;
        padding: 10px 14px;
        border-radius: var(--border-radius-custom);
        border: 2.5px solid #dee2e6;
        transition: border-color 0.2s;
        appearance: auto;
        background-color: #fff;
    }
    #line-select:focus {
        border-color: #1a73e8;
        box-shadow: 0 0 0 4px rgba(26,115,232,0.18);
        outline: none;
    }

    /* Machine Code Tags */
    .machine-tags-area {
        min-height: 50px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        background: #f8f9fa;
        border-radius: var(--border-radius-custom);
        padding: 10px 12px;
        border: 2px dashed #cbd5e1;
    }
    .machine-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(195deg, #344767, #1a2035);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 24px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        animation: tagIn 0.18s ease;
    }
    @@keyframes tagIn {
        from { opacity: 0; transform: scale(0.85); }
        to   { opacity: 1; transform: scale(1); }
    }
    .machine-tag .remove-tag {
        cursor: pointer;
        opacity: 0.8;
        font-size: 20px;
        line-height: 1;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
    }
    .machine-tag .remove-tag:active {
        background: rgba(255,255,255,0.4);
    }

    /* Input - Barcode Gun Friendly */
    #machineInput {
        font-size: 1.15rem;
        font-weight: 600;
        min-height: 56px;
        border-radius: var(--border-radius-custom);
        border: 2.5px solid #dee2e6;
        padding: 10px 14px;
        text-transform: uppercase;
    }
    #machineInput:focus {
        border-color: #1a73e8;
        box-shadow: 0 0 0 4px rgba(26,115,232,0.18);
        outline: none;
    }

    /* Submit Button */
    #btnSubmitBatch {
        min-height: 64px;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        border-radius: var(--border-radius-custom);
        box-shadow: 0 6px 20px rgba(26,115,232,0.35);
    }
    #btnSubmitBatch:active {
        transform: scale(0.97);
    }

    /* Toast Notification Banner */
    #regToast {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        width: 92%;
        max-width: 460px;
        border-radius: 16px;
        font-size: 1rem;
        font-weight: 600;
        padding: 16px 20px;
        display: none;
        box-shadow: 0 12px 36px rgba(0,0,0,0.25);
    }
    #regToast.show {
        display: flex;
        align-items: center;
        gap: 12px;
        animation: toastSlideDown 0.25s ease forwards;
    }
    @@keyframes toastSlideDown {
        from { opacity: 0; transform: translate(-50%, -20px); }
        to   { opacity: 1; transform: translate(-50%, 0); }
    }

    /* Mobile Cards for Grid (< 768px) */
    .mobile-batch-card {
        background: #fff;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 10px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .mobile-batch-card.newest {
        animation: highlightCard 2.5s ease forwards;
    }
    @@keyframes highlightCard {
        0%   { border-color: #2dce89; background-color: rgba(45,206,137,0.15); }
        100% { border-color: #e9ecef; background-color: #fff; }
    }

    /* Sticky Bottom Bar on Mobile */
    @@media (max-width: 768px) {
        .sticky-mobile-bar {
            position: sticky;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            padding: 12px 16px;
            box-shadow: 0 -4px 16px rgba(0,0,0,0.1);
            z-index: 100;
            border-top: 1px solid #e9ecef;
        }
        .desktop-table-view {
            display: none !important;
        }
        .mobile-card-view {
            display: block !important;
        }
    }
    @@media (min-width: 769px) {
        .sticky-mobile-bar {
            position: static;
            padding: 0;
            background: transparent;
            box-shadow: none;
            border: none;
        }
        .mobile-card-view {
            display: none !important;
        }
        .desktop-table-view {
            display: table !important;
        }
    }

    .shift-pill {
        font-size: 0.75rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 10px;
        white-space: nowrap;
    }
</style>

<!-- Mobile Floating Toast Notification -->
<div id="regToast">
    <i class="material-symbols-rounded" id="regToastIcon" style="font-size:28px;"></i>
    <div style="flex:1;">
        <div id="regToastTitle" style="font-size:1rem; font-weight:800;"></div>
        <div id="regToastMsg" style="font-size:0.85rem; opacity:0.9;"></div>
    </div>
</div>

<div class="row">
    <!-- ====== FORM ĐĂNG KÝ (CỘT TRÁI TRÊN MOBILE/DESKTOP) ====== -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="card reg-card my-2 my-md-4">
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-3 px-3 d-flex align-items-center gap-3">
                    <div class="icon icon-shape icon-md bg-white shadow text-center border-radius-md d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="material-symbols-rounded text-primary" style="font-size:1.6rem;">add_circle</i>
                    </div>
                    <div>
                        <h6 class="text-white mb-0 text-md font-weight-bold">Đăng ký đợt sản xuất</h6>
                        <p class="text-white opacity-8 text-xs mb-0">Lưu xong ở lại trang — tiếp tục đợt mới</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <div id="validationMsg" class="alert alert-danger text-white py-2 px-3 text-sm mb-3" style="display:none;border-radius:10px;"></div>

                <!-- 1. CHỌN NHÀ MÁY (PLANT B / E) -->
                <div class="mb-3 mb-md-4">
                    <label class="text-xs text-uppercase font-weight-bolder text-secondary mb-2 d-block">1. Nhà máy (Plant)</label>
                    <div class="d-flex gap-2">
                        <button type="button" class="plant-btn active" data-plant="B" id="btnPlantB">PLANT B</button>
                        <button type="button" class="plant-btn" data-plant="E" id="btnPlantE">PLANT E</button>
                    </div>
                    <input type="hidden" id="selectedPlant" value="B" />
                </div>

                <!-- 2. CHỌN CHUYỀN -->
                <div class="mb-3 mb-md-4">
                    <label class="text-xs text-uppercase font-weight-bolder text-secondary mb-2 d-block" for="line-select">2. Chuyền sản xuất</label>
                    <select id="line-select" class="w-100">
                        <!-- JS Populate -->
                    </select>
                </div>

                <!-- 3. MÃ MÁY (BẮN SÚNG / NHẬP TAY) -->
                <div class="mb-3 mb-md-4">
                    <label class="text-xs text-uppercase font-weight-bolder text-secondary mb-2 d-block">3. Mã máy (Bắn súng vạch hoặc nhập tay)</label>
                    <div class="machine-tags-area mb-2" id="machineTagsArea">
                        <span class="text-secondary text-xs" id="machineTagsPlaceholder">Chưa thêm mã máy nào...</span>
                    </div>
                    <div class="d-flex gap-2">
                        <input type="text" id="machineInput" class="form-control" placeholder="Bắn súng hoặc gõ mã máy..." autocomplete="off" inputmode="text" />
                        <button type="button" id="btnAddMachine" class="btn btn-primary mb-0 px-3 d-flex align-items-center justify-content-center" style="min-height:56px; border-radius:14px; font-size:1.2rem;">
                            <i class="material-symbols-rounded" style="font-size:24px;">add</i>
                        </button>
                    </div>
                </div>

                <!-- 4. CHỌN CA LÀM VIỆC -->
                <div class="mb-4">
                    <label class="text-xs text-uppercase font-weight-bolder text-secondary mb-2 d-block">4. Ca làm việc</label>
                    <div class="shift-grid">
                        <button type="button" class="shift-btn active" data-shift="SHIFT1">
                            <span>Ca 1</span>
                            <small style="font-size:0.7rem;opacity:0.8;">Sáng</small>
                        </button>
                        <button type="button" class="shift-btn" data-shift="SHIFT2">
                            <span>Ca 2</span>
                            <small style="font-size:0.7rem;opacity:0.8;">Chiều</small>
                        </button>
                        <button type="button" class="shift-btn" data-shift="SHIFT3">
                            <span>Ca 3</span>
                            <small style="font-size:0.7rem;opacity:0.8;">Đêm</small>
                        </button>
                        <button type="button" class="shift-btn" data-shift="SHIFT_HC">
                            <span>HC</span>
                            <small style="font-size:0.7rem;opacity:0.8;">Hành chính</small>
                        </button>
                    </div>
                    <input type="hidden" id="selectedShift" value="SHIFT1" />
                </div>

                <!-- NÚT LƯU STICKY CHO MOBILE -->
                <div class="sticky-mobile-bar">
                    <button type="button" id="btnSubmitBatch" class="btn bg-gradient-primary w-100 mb-0 d-flex align-items-center justify-content-center gap-2">
                        <i class="material-symbols-rounded" style="font-size:24px;">save</i>
                        <span id="btnSubmitText">LƯU ĐỢT SẢN XUẤT</span>
                    </button>
                </div>

                <div class="text-center mt-3">
                    <a asp-action="Index" class="text-secondary text-xs font-weight-bold">← Về trang danh sách tổng</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ====== GRID ĐÃ ĐĂNG KÝ HÔM NAY (CỘT PHẢI / BÊN DƯỚI) ====== -->
    <div class="col-12 col-lg-7 mb-4">
        <div class="card today-grid-card my-2 my-md-4">
            <div class="card-header pb-2 ps-3 pt-3 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="mb-0 text-sm font-weight-bolder d-flex align-items-center gap-2">
                        <i class="material-symbols-rounded text-primary" style="font-size:22px;">history</i>
                        Đã đăng ký hôm nay
                    </h6>
                    <p class="text-xs text-secondary mb-0">Bấm <strong>Quét</strong> để bắt đầu nhập PCard</p>
                </div>
                <span class="badge bg-gradient-primary text-sm px-3 py-2" id="todayCount">0 đợt</span>
            </div>
            <div class="card-body p-2 p-md-3">
                <!-- VIEW 1: DESKTOP TABLE VIEW -->
                <div class="table-responsive desktop-table-view" style="max-height: 580px; overflow-y: auto;">
                    <table class="table align-items-center mb-0 table-sm">
                        <thead style="position: sticky; top: 0; background: #fff; z-index: 1;">
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center ps-2">#</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Chuyền / Ca</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Mã Máy</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Thẻ</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Giờ</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="todayGridBody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-secondary text-sm">Đang tải...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- VIEW 2: MOBILE CARD VIEW (< 768px) -->
                <div id="mobileCardContainer" class="mobile-card-view" style="max-height: 520px; overflow-y: auto;">
                    <!-- JS Mobile Cards -->
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
    (function () {
        const WEB_BASE = '@Url.Content("~/Production")';

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        const plantLines = {
            'B': [
                "1-CB","1-1","1-2","1-3","1-4","1-5","1-6","1-7","1-8",
                "2-CB","2-9","2-10","2-11","2-12","2-13","2-14","2-15","2-16",
                "3-CB","3-17","3-18","3-19","3-20","3-21","3-22","3-23","3-24",
                "4-CB","4-25","4-26","4-27","4-28","4-29","4-30","4-31","4-32",
                "5-CB","5-33","5-34","5-35","5-36","5-37","5-38","5-39","5-40",
                "6-CB","6-41","6-42","6-43","6-44","6-45","6-46","6-47","6-48",
                "7-CB","7-49","7-50","7-51","7-52","7-53","7-54","7-55","7-56",
                "8-CB","8-57","8-58","8-59","8-60","8-61","8-62","8-63","8-64",
                "9-CB","9-65","9-66","9-67","9-68","9-69","9-70","9-71","9-72",
                "10-CB","10-73","10-74","10-75","10-76","10-77","10-78","10-79","10-80",
                "11-CB","11-81","11-82","11-83","11-84","11-85","11-86","11-87","11-88",
                "12-CB","12-89","12-90","12-91","12-92","12-93","12-94","12-95","12-96"
            ],
            'E': [
                "1-01","1-02","1-03","1-04","1-05","1-06","1-07","1-08","1-09","1-10",
                "2-01","2-02","2-03","2-04","2-05","2-06","2-07","2-08","2-09","2-10",
                "3-01","3-02","3-03","3-04","3-05","3-06","3-07","3-08","3-09","3-10",
                "4-01","4-02","4-03","4-04","4-05","4-06","4-07","4-08","4-09","4-10",
                "5-01","5-02","5-03","5-04","5-05","5-06","5-07","5-08","5-09","5-10",
                "6-01","6-02","6-03","6-04","6-05","6-06","6-07","6-08","6-09","6-10",
                "7-01","7-02","7-03","7-04","7-05","7-06","7-07"
            ]
        };

        const shiftLabels = {
            'SHIFT1': 'Ca 1', 'SHIFT2': 'Ca 2', 'SHIFT3': 'Ca 3', 'SHIFT_HC': 'Hành chính'
        };

        let machineList = [];
        let selectedPlant = 'B';
        let selectedShift = 'SHIFT1';
        let lastSavedLine = '';

        const lineSelect      = document.getElementById('line-select');
        const machineInput    = document.getElementById('machineInput');
        const btnAddMachine   = document.getElementById('btnAddMachine');
        const machineTagsArea = document.getElementById('machineTagsArea');
        const machineTagsPlaceholder = document.getElementById('machineTagsPlaceholder');
        const hiddenPlant     = document.getElementById('selectedPlant');
        const hiddenShift     = document.getElementById('selectedShift');
        const btnSubmit       = document.getElementById('btnSubmitBatch');
        const btnSubmitText   = document.getElementById('btnSubmitText');
        const validationMsg   = document.getElementById('validationMsg');
        const todayGridBody   = document.getElementById('todayGridBody');
        const mobileCardContainer = document.getElementById('mobileCardContainer');
        const todayCount      = document.getElementById('todayCount');
        const toast           = document.getElementById('regToast');

        // Plant Select Button Click
        document.querySelectorAll('.plant-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.plant-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedPlant = btn.dataset.plant;
                hiddenPlant.value = selectedPlant;
                populateLines(selectedPlant, lastSavedLine);
            });
        });

        // Shift Select Button Click
        document.querySelectorAll('.shift-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.shift-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedShift = btn.dataset.shift;
                hiddenShift.value = selectedShift;
            });
        });

        function populateLines(plant, selectValue) {
            const lines = plantLines[plant] || [];
            lineSelect.innerHTML = '';
            lines.forEach(function (line) {
                const opt = document.createElement('option');
                opt.value = line;
                opt.textContent = line;
                if (line === selectValue) opt.selected = true;
                lineSelect.appendChild(opt);
            });
        }

        function renderMachineTags() {
            machineTagsArea.querySelectorAll('.machine-tag').forEach(t => t.remove());

            if (machineList.length === 0) {
                machineTagsPlaceholder.style.display = 'inline';
            } else {
                machineTagsPlaceholder.style.display = 'none';
                machineList.forEach(function (code) {
                    const tag = document.createElement('span');
                    tag.className = 'machine-tag';
                    tag.innerHTML = code + '<span class="material-symbols-rounded remove-tag" data-code="' + code + '">close</span>';
                    tag.querySelector('.remove-tag').addEventListener('click', function () {
                        machineList = machineList.filter(m => m !== code);
                        renderMachineTags();
                    });
                    machineTagsArea.appendChild(tag);
                });
            }
        }

        function addMachineCode() {
            const code = machineInput.value.trim().toUpperCase();
            if (!code) return;
            if (!machineList.includes(code)) {
                machineList.push(code);
                renderMachineTags();
            }
            machineInput.value = '';
            machineInput.focus();
        }

        btnAddMachine.addEventListener('click', addMachineCode);
        machineInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); addMachineCode(); }
        });

        let toastTimer = null;
        function showToast(success, title, msg) {
            const icon = document.getElementById('regToastIcon');
            const titleEl = document.getElementById('regToastTitle');
            const msgEl = document.getElementById('regToastMsg');
            toast.className = 'show';
            toast.style.background = success ? 'linear-gradient(195deg, #2dce89, #1aaf6c)' : 'linear-gradient(195deg, #f5365c, #c0392b)';
            toast.style.color = '#fff';
            icon.textContent = success ? 'check_circle' : 'error';
            titleEl.textContent = title;
            msgEl.textContent = msg;
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { toast.className = ''; }, 3500);
        }

        function validate() {
            if (!lineSelect.value) {
                validationMsg.textContent = 'Vui lòng chọn Chuyền sản xuất!';
                validationMsg.style.display = 'block';
                lineSelect.focus();
                return false;
            }
            if (machineList.length === 0) {
                validationMsg.textContent = 'Vui lòng thêm ít nhất 1 mã máy!';
                validationMsg.style.display = 'block';
                machineInput.focus();
                return false;
            }
            validationMsg.style.display = 'none';
            return true;
        }

        // AJAX SUBMIT — STAY ON PAGE
        btnSubmit.addEventListener('click', async function () {
            if (!validate()) return;

            btnSubmit.disabled = true;
            btnSubmitText.textContent = 'ĐANG LƯU...';
            btnSubmit.classList.add('opacity-75');

            const payload = {
                LineCode:  lineSelect.value,
                MachineCode: machineList.join(', '),
                CShift:    selectedShift,
                Plant:     selectedPlant
            };

            try {
                const res = await fetch(WEB_BASE + '/CreateAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    const seqNo = data.seq || data.SEQ;
                    lastSavedLine = lineSelect.value;

                    // Keep Plant/Line/Shift — reset ONLY machine codes for instant entry
                    machineList = [];
                    renderMachineTags();
                    machineInput.focus();

                    showToast(true, `ĐÃ LƯU ĐỢT #${seqNo} ✓`, `Chuyền ${lastSavedLine} · ${shiftLabels[selectedShift]} · Plant ${selectedPlant}`);

                    // Mobile haptic vibration
                    if (navigator.vibrate) navigator.vibrate(120);

                    // Reload today grid
                    await loadTodayGrid(seqNo);

                } else {
                    showToast(false, 'LƯU THẤT BẠI', data.message || 'Vui lòng thử lại!');
                    if (navigator.vibrate) navigator.vibrate([100, 60, 100]);
                }
            } catch (err) {
                console.error(err);
                showToast(false, 'LỖI KẾT NỐI', 'Không thể kết nối máy chủ!');
            } finally {
                btnSubmit.disabled = false;
                btnSubmitText.textContent = 'LƯU ĐỢT SẢN XUẤT';
                btnSubmit.classList.remove('opacity-75');
            }
        });

        function formatTime(dgather) {
            if (!dgather || dgather.length < 12) return dgather || '';
            return dgather.substring(8, 10) + ':' + dgather.substring(10, 12);
        }

        function shiftBadge(shift) {
            const colors = {
                'SHIFT1': 'bg-gradient-info',
                'SHIFT2': 'bg-gradient-warning',
                'SHIFT3': 'bg-gradient-dark',
                'SHIFT_HC': 'bg-gradient-secondary'
            };
            const cls = colors[shift] || 'bg-gradient-secondary';
            const label = shiftLabels[shift] || shift;
            return `<span class="shift-pill ${cls} text-white">${label}</span>`;
        }

        async function loadTodayGrid(newestSeq) {
            const today = new Date();
            const dateStr = today.getFullYear().toString()
                + String(today.getMonth() + 1).padStart(2, '0')
                + String(today.getDate()).padStart(2, '0');

            try {
                const res = await fetch(WEB_BASE + `/BatchesJson?status=ALL&date=${dateStr}`);
                const data = await res.json();
                const batches = data.data || [];

                todayCount.textContent = batches.length + ' đợt';

                if (batches.length === 0) {
                    todayGridBody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-secondary text-sm">Chưa có đợt nào hôm nay.</td></tr>';
                    mobileCardContainer.innerHTML = '<div class="text-center py-4 text-secondary text-sm">Chưa có đợt nào hôm nay.</div>';
                    return;
                }

                // 1. Desktop Table Body
                todayGridBody.innerHTML = batches.map(function (b) {
                    const isNew = b.SEQ === newestSeq;
                    const statusBadge = b.STATUS === 'Y'
                        ? '<span class="badge badge-sm bg-gradient-success">Xong</span>'
                        : '<span class="badge badge-sm bg-gradient-warning">Mở</span>';

                    const machines = b.MACHINE_CODE
                        ? b.MACHINE_CODE.split(',').map(m => `<span class="badge badge-sm bg-gradient-secondary me-1">${m.trim()}</span>`).join('')
                        : '<span class="text-secondary text-xxs">N/A</span>';

                    const scanBtn = b.STATUS === 'N'
                        ? `<a href="${WEB_BASE}/Scan?seq=${b.SEQ}" class="btn btn-sm bg-gradient-success mb-0 d-inline-flex align-items-center gap-1 px-3 py-1" style="font-size:0.8rem; font-weight:700;">
                               <i class="material-symbols-rounded" style="font-size:16px;">qr_code_scanner</i>Quét
                           </a>`
                        : `<a href="${WEB_BASE}/Scan?seq=${b.SEQ}" class="btn btn-sm btn-outline-secondary mb-0 d-inline-flex align-items-center gap-1 px-2 py-1" style="font-size:0.75rem;">
                               <i class="material-symbols-rounded" style="font-size:14px;">visibility</i>Xem
                           </a>`;

                    return `<tr class="${isNew ? 'newest-row' : ''}">
                        <td class="align-middle text-center ps-2">
                            <span class="text-xs font-weight-bold">#${b.SEQ}</span><br/>
                            ${statusBadge}
                        </td>
                        <td class="align-middle ps-2">
                            <span class="text-sm font-weight-bold d-block">${b.LINE_CODE || '-'}</span>
                            ${shiftBadge(b.C_SHIFT)} <span class="text-xxs text-secondary">P${b.PLANT || ''}</span>
                        </td>
                        <td class="align-middle ps-2">${machines}</td>
                        <td class="align-middle text-center">
                            <span class="text-sm font-weight-bold">${b.TOTAL_QTY}</span>
                            <span class="text-xxs text-secondary d-block">thẻ</span>
                        </td>
                        <td class="align-middle text-center">
                            <span class="text-xs text-secondary">${formatTime(b.D_GATHER)}</span>
                        </td>
                        <td class="align-middle text-center">${scanBtn}</td>
                    </tr>`;
                }).join('');

                // 2. Mobile Cards View (< 768px)
                mobileCardContainer.innerHTML = batches.map(function (b) {
                    const isNew = b.SEQ === newestSeq;
                    const scanBtnCls = b.STATUS === 'N' ? 'btn-success' : 'btn-outline-secondary';
                    const scanBtnText = b.STATUS === 'N' ? 'QUÉT PCARD' : 'XEM';

                    return `<div class="mobile-batch-card ${isNew ? 'newest' : ''}">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-dark text-white">#${b.SEQ}</span>
                                <strong class="text-md text-dark">${b.LINE_CODE || '-'}</strong>
                                ${shiftBadge(b.C_SHIFT)}
                            </div>
                            <div class="text-xs text-secondary">
                                Máy: <strong class="text-dark">${b.MACHINE_CODE || 'N/A'}</strong> · ${formatTime(b.D_GATHER)}
                            </div>
                            <div class="text-xs mt-1">
                                SL đã quét: <strong class="text-primary text-sm">${b.TOTAL_QTY} thẻ</strong>
                            </div>
                        </div>
                        <div>
                            <a href="${WEB_BASE}/Scan?seq=${b.SEQ}" class="btn ${scanBtnCls} mb-0 px-3 py-2 d-flex align-items-center gap-1 font-weight-bold" style="border-radius:10px; font-size:0.85rem;">
                                <i class="material-symbols-rounded" style="font-size:18px;">qr_code_scanner</i> ${scanBtnText}
                            </a>
                        </div>
                    </div>`;
                }).join('');

            } catch (err) {
                console.error('loadTodayGrid error:', err);
                todayGridBody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger text-sm">Lỗi tải dữ liệu!</td></tr>';
            }
        }

        populateLines('B', '');
        renderMachineTags();
        machineInput.focus();

        (function autoDetectShift() {
            const h = new Date().getHours();
            let shift = 'SHIFT1';
            if (h >= 14 && h < 22) shift = 'SHIFT2';
            else if (h >= 22 || h < 6) shift = 'SHIFT3';
            else if (h >= 7 && h < 14) shift = 'SHIFT1';

            document.querySelectorAll('.shift-btn').forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`.shift-btn[data-shift="${shift}"]`);
            if (activeBtn) activeBtn.classList.add('active');
            selectedShift = shift;
            hiddenShift.value = shift;
        })();

        loadTodayGrid(null);
    })();
    </script>
}
