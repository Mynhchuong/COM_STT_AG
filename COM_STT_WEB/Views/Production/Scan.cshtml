@model COM_STT_WEB.Models.Production.PcardScanViewModel
@{
    ViewData["Title"] = $"Quét PCard - Đợt #{Model.Batch.Seq}";
}

<style>
    :root {
        --touch-target-height: 56px;
        --border-radius-custom: 14px;
    }

    body {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
    }

    #scan-reader {
        border: 4px solid #dee2e6;
        border-radius: 16px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    #scan-reader.flash-success {
        border-color: #2dce89 !important;
        box-shadow: 0 0 24px rgba(45, 206, 137, 0.85) !important;
    }
    #scan-reader.flash-error {
        border-color: #f5365c !important;
        box-shadow: 0 0 24px rgba(245, 54, 92, 0.85) !important;
    }

    .pcard-item {
        transition: all 0.3s ease;
    }
    .pcard-item.new-scan {
        background-color: rgba(45, 206, 137, 0.18) !important;
        animation: pulse-green 1.2s infinite alternate;
    }

    @@keyframes pulse-green {
        from { background-color: rgba(45, 206, 137, 0.2); }
        to   { background-color: rgba(45, 206, 137, 0.05); }
    }

    /* Mobile-optimized Barcode Input */
    #manualPcardInput {
        font-size: 1.25rem !important;
        font-weight: 700 !important;
        min-height: 56px !important;
        border-radius: var(--border-radius-custom) !important;
        border: 2.5px solid #dee2e6 !important;
        padding: 10px 16px !important;
        letter-spacing: 1px;
        text-transform: uppercase;
        background-color: #fff;
    }
    #manualPcardInput:focus {
        border-color: #1a73e8 !important;
        box-shadow: 0 0 0 4px rgba(26,115,232,0.2) !important;
        outline: none;
    }

    #btnSubmitManual {
        min-height: 56px;
        min-width: 64px;
        border-radius: var(--border-radius-custom);
        font-size: 1.2rem;
    }

    /* Mobile Status Banner */
    #scan-status-message {
        font-size: 1rem;
        font-weight: 800;
        min-height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 16px;
        transition: all 0.2s ease;
    }

    /* Mobile Card Layout for Scanned Cards */
    .mobile-pcard-item {
        background: #fff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 8px;
        border: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .mobile-pcard-item.new-scan {
        border-color: #2dce89;
        background: rgba(45,206,137,0.1);
    }

    @@media (max-width: 768px) {
        .desktop-pcard-table {
            display: none !important;
        }
        .mobile-pcard-cards {
            display: block !important;
        }
    }
    @@media (min-width: 769px) {
        .mobile-pcard-cards {
            display: none !important;
        }
        .desktop-pcard-table {
            display: table !important;
        }
    }
</style>

<link href="~/assets/css/global-style.css" rel="stylesheet" asp-append-version="true" />

<div class="row">
    <!-- THÔNG TIN ĐỢT (THẺ HEADER THÔNG MINH ON MOBILE) -->
    <div class="col-12 mb-3">
        <div class="card bg-gradient-dark border-radius-lg">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-white text-dark px-3 py-2 text-md font-weight-bolder">Đợt #@Model.Batch.Seq</span>
                    <span class="text-white text-sm">
                        Plant: <strong class="text-md text-warning">@Model.Batch.Plant</strong> · 
                        Chuyền: <strong class="text-md text-info">@Model.Batch.LineCode</strong> · 
                        Ca: <strong class="text-md text-success">@(Model.Batch.CShift == "SHIFT_HC" ? "Hành chính" : Model.Batch.CShift?.Replace("SHIFT", ""))</strong>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-between">
                    <span class="text-white opacity-8 text-xs me-2">Máy: @Model.Batch.MachineCode</span>
                    <a asp-action="Create" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1 py-2 px-3">
                        <i class="material-symbols-rounded">arrow_back</i>Đăng ký mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT TRÁI: CAMERA QUÉT + SÚNG BẮN MÃ VẠCH / NHẬP TAY -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="card h-100 border-radius-lg">
            <div class="card-header pb-0 ps-3 pt-3">
                <h6 class="mb-0 text-sm font-weight-bold">Bắt đầu quét mã PCard</h6>
                <p class="text-xs text-secondary mb-0">Quét camera hoặc dùng súng bắn mã vạch</p>
            </div>
            <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
                <!-- KHUNG CHỨA CAMERA -->
                <div>
                    <div id="idle-section" class="py-4 py-md-5 bg-light border-radius-lg border border-dashed border-2">
                        <i class="material-symbols-rounded text-secondary text-5xl mb-2">photo_camera</i>
                        <p class="text-secondary text-xs mb-3">Tự động khởi động camera khi chạm nút</p>
                        <button id="btn-start-scan" type="button" class="btn bg-gradient-primary btn-lg px-4 py-3 mb-0 d-inline-flex align-items-center gap-2" style="border-radius:14px; min-height:56px;">
                            <i class="material-symbols-rounded text-lg">qr_code_scanner</i>BẮT ĐẦU QUÉT CAMERA
                        </button>
                    </div>

                    <div id="scan-section" class="d-none">
                        <div id="scan-reader" class="mx-auto bg-black" style="max-width: 480px;"></div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button id="btn-stop-scan" type="button" class="btn btn-outline-danger mb-0 d-inline-flex align-items-center gap-1 px-4 py-2" style="border-radius:12px;">
                                <i class="material-symbols-rounded">videocam_off</i>Tắt Camera
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ô BẮN SÚNG MÃ VẠCH / NHẬP TAY THỦ CÔNG -->
                <div class="mt-3 border-top pt-3">
                    <label for="manualPcardInput" class="text-sm font-weight-bolder text-dark text-start d-block mb-1">Bắn súng hoặc nhập mã PCard</label>
                    <div class="d-flex gap-2 mb-2">
                        <input type="text" id="manualPcardInput" placeholder="Ví dụ: PAB6704006010" class="form-control" autocomplete="off" inputmode="text" />
                        <button type="button" id="btnSubmitManual" class="btn bg-gradient-dark mb-0 px-3 d-flex align-items-center justify-content-center">
                            <i class="material-symbols-rounded text-lg" style="font-size:24px;">send</i>
                        </button>
                    </div>
                    
                    <!-- KẾT QUẢ QUÉT BANNER -->
                    <div id="scan-status-message" class="text-xs font-weight-bolder text-center" style="display:none;">
                        <!-- Status text populates here dynamically -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: DANH SÁCH PCARD ĐÃ QUÉT -->
    <div class="col-12 col-lg-7 mb-4">
        <div class="card h-100 border-radius-lg">
            <div class="card-header pb-2 ps-3 pt-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-0 text-sm font-weight-bolder">Danh sách PCard đã quét</h6>
                    <p class="text-xs text-secondary mb-0">Hiển thị thông tin tự động từ AGERP</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-gradient-success text-md px-3 py-2 border-radius-md" id="totalScannedCount">0 thẻ đã quét</span>
                </div>
            </div>
            <div class="card-body p-2 p-md-3">
                <!-- VIEW 1: DESKTOP TABLE VIEW -->
                <div class="table-responsive desktop-pcard-table" style="max-height: 480px; overflow-y: auto;">
                    <table class="table align-items-center mb-0" id="pcardsTable">
                        <thead>
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Mã PCard</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Model / Style</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Size / Order / Parts</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Số lượng</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Xoá</th>
                            </tr>
                        </thead>
                        <tbody id="pcardsListContainer">
                            @if (!Model.Pcards.Any())
                            {
                                <tr id="noDataRow">
                                    <td colspan="5" class="text-center py-5">
                                        <p class="text-secondary text-sm mb-0">Chưa quét mã PCard nào cho đợt sản xuất này.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in Model.Pcards.OrderByDescending(x => x.PcardNo))
                                {
                                    <tr class="pcard-item" id="row-@p.PcardNo" data-pcard="@p.PcardNo">
                                        <td>
                                            <span class="text-sm font-weight-bold text-dark">@p.PcardNo</span>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-xs">@p.CGroupSum</h6>
                                                <p class="text-xxs text-secondary mb-0">@p.CStyle</p>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-xs">Size @p.CSize · Order @p.COrder</h6>
                                                <p class="text-xxs text-secondary mb-0">Parts No: @p.IPartsNo</p>
                                            </div>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="text-xs font-weight-bold text-dark">@p.QQty pcs</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <button type="button" class="btn btn-link text-danger p-0 mb-0 btn-delete-pcard" data-pcard="@p.PcardNo" aria-label="Xoá">
                                                <i class="material-symbols-rounded">delete_outline</i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- VIEW 2: MOBILE CARD VIEW (< 768px) -->
                <div id="mobilePcardCardsContainer" class="mobile-pcard-cards" style="max-height: 460px; overflow-y: auto;">
                    @if (!Model.Pcards.Any())
                    {
                        <div class="text-center py-4 text-secondary text-sm" id="noDataMobileCard">
                            Chưa quét mã PCard nào.
                        </div>
                    }
                    else
                    {
                        @foreach (var p in Model.Pcards.OrderByDescending(x => x.PcardNo))
                        {
                            <div class="mobile-pcard-item" id="mobile-row-@p.PcardNo" data-pcard="@p.PcardNo">
                                <div>
                                    <strong class="text-dark text-sm d-block">@p.PcardNo</strong>
                                    <div class="text-xs text-secondary mt-1">
                                        <strong>@p.CGroupSum</strong> · Style: @p.CStyle
                                    </div>
                                    <div class="text-xs text-secondary">
                                        Size @p.CSize · Order @p.COrder · Qty: <strong class="text-primary">@p.QQty pcs</strong>
                                    </div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-link text-danger p-2 mb-0 btn-delete-pcard" data-pcard="@p.PcardNo" aria-label="Xoá">
                                        <i class="material-symbols-rounded" style="font-size:22px;">delete_outline</i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/global-function.js" asp-append-version="true"></script>
    <script>
        window.scanConfig = {
            seq: @Model.Batch.Seq,
            webBaseUrl: '@Url.Content("~/Production")'
        };
    </script>
    <script src="~/js/pages/production-scan.js" asp-append-version="true"></script>
}
