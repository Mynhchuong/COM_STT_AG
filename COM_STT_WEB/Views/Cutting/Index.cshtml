@{
    ViewData["Title"] = "Chuyền cắt";
}

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="icon icon-shape icon-lg bg-gradient-dark shadow text-center border-radius-xl d-flex align-items-center justify-content-center flex-shrink-0">
                    <i class="material-symbols-rounded text-white" style="font-size:1.85rem;" aria-hidden="true">content_cut</i>
                </div>
                <div>
                    <h5 class="mb-1">Chuyền cắt</h5>
                    <p class="text-secondary text-sm mb-0">Quét PCARD để Check In hoặc Out hàng công đoạn cắt.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-6 mb-4">
        <a asp-action="CheckIn" class="text-decoration-none">
            <div class="card h-100 quick-tile bg-gradient-success">
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="material-symbols-rounded text-white mb-2" style="font-size:2.75rem;" aria-hidden="true">login</i>
                    <p class="mb-1 text-white font-weight-bolder text-lg">CHECK IN</p>
                    <p class="text-xs text-white opacity-8 mb-0">Nhập hàng vào</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 mb-4">
        <a asp-action="CheckOut" class="text-decoration-none">
            <div class="card h-100 quick-tile bg-gradient-danger">
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="material-symbols-rounded text-white mb-2" style="font-size:2.75rem;" aria-hidden="true">logout</i>
                    <p class="mb-1 text-white font-weight-bolder text-lg">OUT HÀNG</p>
                    <p class="text-xs text-white opacity-8 mb-0">Xuất hàng ra</p>
                </div>
            </div>
        </a>
    </div>
</div>
