@{
    ViewData["Title"] = "Check In - Chuyền cắt";
}

<style>
    #cardNoInput {
        font-size: 1.25rem;
        font-weight: 700;
        min-height: 56px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    #scan-reader {
        border: 4px solid #dee2e6;
        border-radius: 16px;
        overflow: hidden;
        max-height: 320px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    #scan-reader video,
    #scan-reader canvas {
        width: 100% !important;
        max-height: 320px;
        object-fit: cover;
    }
    #scan-reader.flash-success {
        border-color: #2dce89 !important;
        box-shadow: 0 0 24px rgba(45, 206, 137, 0.85) !important;
    }
    #scan-reader.flash-error {
        border-color: #f5365c !important;
        box-shadow: 0 0 24px rgba(245, 54, 92, 0.85) !important;
    }
</style>

<div class="row">
    <!-- CỘT TRÁI: CAMERA QUÉT + SÚNG BẮN MÃ VẠCH / NHẬP TAY -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="card h-100 border-radius-lg">
            <div class="card-header pb-0 ps-3 pt-3 d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="mb-0 text-sm font-weight-bold">Quét PCARD (Chuyền cắt)</h6>
                    <p class="text-xs text-secondary mb-0">Quét camera hoặc dùng súng bắn mã vạch</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-dark btn-sm mb-0 d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width:40px; height:40px; border-radius:12px;" title="Về trang Chuyền cắt">
                    <i class="material-symbols-rounded" style="font-size:20px;">arrow_back</i>
                </a>
            </div>
            <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
                <div>
                    <div id="idle-section" class="py-4 py-md-5 bg-light border-radius-lg border border-dashed border-2">
                        <i class="material-symbols-rounded text-secondary text-5xl mb-2">photo_camera</i>
                        <p class="text-secondary text-xs mb-3">Tự động khởi động camera khi chạm nút</p>
                        <button id="btn-start-scan" type="button" class="btn bg-gradient-dark btn-lg px-4 py-3 mb-0 d-inline-flex align-items-center gap-2" style="border-radius:14px; min-height:56px;">
                            <i class="material-symbols-rounded text-lg">qr_code_scanner</i>BẮT ĐẦU QUÉT CAMERA
                        </button>
                    </div>

                    <div id="scan-section" class="d-none">
                        <div id="scan-reader" class="mx-auto bg-black" style="max-width: 480px;"></div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button id="btn-stop-scan" type="button" class="btn btn-outline-danger mb-0 d-inline-flex align-items-center gap-1 px-4 py-2" style="border-radius:12px;">
                                <i class="material-symbols-rounded">videocam_off</i>Tắt Camera
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ô BẮN SÚNG MÃ VẠCH / NHẬP TAY THỦ CÔNG -->
                <div class="mt-3 border-top pt-3">
                    <label for="cardNoInput" class="text-sm font-weight-bolder text-dark text-start d-block mb-1">Bắn súng hoặc nhập mã PCARD</label>
                    <div class="d-flex gap-2 mb-2">
                        <input type="text" id="cardNoInput" placeholder="VD: PAB6728002239" class="form-control" autocomplete="off" inputmode="text" />
                        <button type="button" id="btnLookup" class="btn bg-gradient-dark mb-0 px-3 d-flex align-items-center justify-content-center">
                            <i class="material-symbols-rounded text-lg" style="font-size:24px;">send</i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: THÔNG TIN PCARD -->
    <div class="col-12 col-lg-7 mb-4">
        <div class="card h-100 border-radius-lg">
            <div class="card-header pb-0 ps-3 pt-3">
                <h6 class="mb-0 text-sm font-weight-bolder">Thông tin PCARD</h6>
                <p class="text-xs text-secondary mb-0">Công đoạn cắt (C_ORD_OP = UCT)</p>
            </div>
            <div class="card-body p-3">
                <div id="lookupMessage" class="text-sm font-weight-bold mb-3" style="display:none;"></div>

                <div id="cardInfoPanel" style="display:none;">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><th class="text-secondary text-xs">I_CARD_NO</th><td id="infoICardNo" class="font-weight-bold"></td></tr>
                                <tr><th class="text-secondary text-xs">Status</th><td id="infoStatus"></td></tr>
                                <tr><th class="text-secondary text-xs">Q_QTY</th><td id="infoQQty"></td></tr>
                                <tr><th class="text-secondary text-xs">C_ORD_OP</th><td id="infoCOrdOp"></td></tr>
                                <tr><th class="text-secondary text-xs">C_LINE</th><td id="infoCLine"></td></tr>
                                <tr><th class="text-secondary text-xs">I_PARTS_NO</th><td id="infoIPartsNo"></td></tr>
                                <tr><th class="text-secondary text-xs">C_STYLE</th><td id="infoCStyle"></td></tr>
                                <tr><th class="text-secondary text-xs">F_CLOSE</th><td id="infoFClose"></td></tr>
                                <tr><th class="text-secondary text-xs">Q_PLAN</th><td id="infoQPlan"></td></tr>
                                <tr><th class="text-secondary text-xs">Q_GATHER</th><td id="infoQGather"></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="emptyState" class="text-center py-5">
                    <p class="text-secondary text-sm mb-0">Chưa có dữ liệu — quét hoặc nhập mã PCARD bên trái.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/cutting-checkin.js" asp-append-version="true"></script>
}
