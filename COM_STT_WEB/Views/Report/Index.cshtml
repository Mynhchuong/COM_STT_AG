@{
    ViewData["Title"] = "Báo cáo - Sản xuất";
}

<style>
    .pivot-table-wrap {
        overflow: auto;
        max-height: 72vh;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    #pivotTable {
        border-collapse: separate;
        border-spacing: 0;
        white-space: nowrap;
        font-size: 0.82rem;
    }

    #pivotTable th,
    #pivotTable td {
        padding: 0.4rem 0.5rem;
        border-bottom: 1px solid #e9ecef;
        border-right: 1px solid #f1f3f5;
        text-align: right;
        min-width: 44px;
    }
    #pivotTable td.size-col-zero { color: #adb5bd; }

    #pivotTable thead th {
        position: sticky;
        top: 0;
        background: #344767;
        color: #fff;
        z-index: 3;
        text-align: center;
        font-weight: 700;
    }

    #pivotTable th.meta-col,
    #pivotTable td.meta-col,
    #pivotTable th.total-col,
    #pivotTable td.total-col {
        position: sticky;
        background: #fff;
        z-index: 2;
        font-weight: 700;
    }
    #pivotTable th.meta-col { text-align: left; }
    #pivotTable thead th.meta-col,
    #pivotTable thead th.total-col {
        z-index: 4;
        background: #344767;
    }

    #pivotTable .col-po        { left: 0px;   width: 90px;  min-width: 90px;  max-width: 90px; }
    #pivotTable .col-style     { left: 90px;  width: 110px; min-width: 110px; max-width: 110px; }
    #pivotTable .col-part-no   { left: 200px; width: 80px;  min-width: 80px;  max-width: 80px; }
    #pivotTable .col-part-name { left: 280px; width: 200px; min-width: 200px; max-width: 200px; text-align: left; }
    #pivotTable .col-line-type { left: 480px; width: 100px; min-width: 100px; max-width: 100px; }
    #pivotTable .col-total     { left: 580px; width: 80px;  min-width: 80px;  max-width: 80px; }

    #pivotTable tr.row-qplan td { background: rgba(52, 71, 103, 0.06); font-weight: 800; border-top: 2px solid #344767; }
    #pivotTable tr.row-setqty td { background: rgba(45, 206, 137, 0.06); }
    #pivotTable tr.row-balance td { background: rgba(245, 54, 92, 0.05); }
    #pivotTable tr.row-balance td.zero { color: #2dce89; font-weight: 800; }
    #pivotTable tr.row-balance td.nonzero { color: #f5365c; }

    #pivotTable td.total-col,
    #pivotTable th.total-col {
        border-right: 2px solid #344767;
        font-weight: 800;
    }
</style>

<div class="row">
    <div class="col-12 mb-3">
        <div class="card bg-gradient-info border-radius-lg text-white">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon icon-shape bg-white text-info shadow border-radius-md d-flex align-items-center justify-content-center">
                        📊
                    </div>
                    <div>
                        <h5 class="text-white font-weight-bolder mb-0">BÁO CÁO — KẾ HOẠCH / ĐÃ SET / CÒN LẠI</h5>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-white btn-sm mb-0 d-inline-flex align-items-center gap-1">
                    🏠 Trang chủ
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 mb-3">
        <div class="card border-radius-lg">
            <div class="card-body p-3 d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label for="fromDateInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Từ ngày</label>
                    <input type="date" id="fromDateInput" class="form-control" style="min-height:44px;" />
                </div>
                <div>
                    <label for="toDateInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Đến ngày</label>
                    <input type="date" id="toDateInput" class="form-control" style="min-height:44px;" />
                </div>
                <div>
                    <label for="poInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Order (PO)</label>
                    <input type="text" id="poInput" class="form-control" placeholder="Để trống = tất cả" autocomplete="off" style="min-height:44px; max-width:160px;" />
                </div>
                <div>
                    <label for="partInput" class="text-xs font-weight-bolder text-dark mb-1 d-block">Part No</label>
                    <input type="text" id="partInput" class="form-control" placeholder="Để trống = tất cả" autocomplete="off" style="min-height:44px; max-width:160px;" />
                </div>
                <button type="button" id="btnFindReport" class="btn bg-gradient-info mb-0 px-4 d-flex align-items-center gap-1" style="min-height:44px;">
                    🔍 Tìm
                </button>
                <span id="reportStatus" class="text-sm text-secondary ms-2"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-radius-lg">
            <div class="card-body p-3">
                <div class="pivot-table-wrap">
                    <table id="pivotTable" class="mb-0 w-100" style="display:none;">
                        <thead>
                            <tr id="pivotHeaderRow"></tr>
                        </thead>
                        <tbody id="pivotBody"></tbody>
                    </table>
                    <div id="pivotEmpty" class="text-center py-5 text-secondary text-sm">
                        📊
                        <p class="mb-0">Chọn khoảng thời gian rồi bấm Tìm để xem báo cáo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/report.js" asp-append-version="true"></script>
}
