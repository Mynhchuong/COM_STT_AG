@model COM_STT_WEB.Models.ComingSoonViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-5 text-center position-relative">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm mb-0 d-flex align-items-center justify-content-center p-0 position-absolute" style="width:40px; height:40px; border-radius:12px; top:1rem; right:1rem;" title="Về trang chủ">
                    🏠
                </a>
                <div class="icon icon-shape icon-lg @Model.GradientClass shadow text-center border-radius-xl mx-auto mb-3 d-flex align-items-center justify-content-center">
                    <span class="text-white" style="font-size:1.85rem;" aria-hidden="true">@Model.Icon</span>
                </div>
                <h5 class="mb-1">@Model.Title</h5>
                <p class="text-secondary text-sm mb-0">Đang phát triển — sẽ cập nhật nghiệp vụ sau.</p>
            </div>
        </div>
    </div>
</div>
