@{
    ViewData["Title"] = "Test scan hàng loạt";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pb-0 d-flex align-items-center gap-3">
                <div class="icon icon-shape icon-lg bg-gradient-primary shadow text-center border-radius-lg d-flex align-items-center justify-content-center">
                    📷
                </div>
                <div>
                    <h5 class="mb-0">Test scan hàng loạt — PCard</h5>
                    <p class="text-secondary text-sm mb-0">Demo: quét liên tục từng tem một, không cần canh giữa</p>
                </div>
            </div>

            <div class="card-body">
                <!-- ===== TRẠNG THÁI 1: CHƯA QUÉT — CHỈ CÓ NÚT "QUÉT MÃ" ===== -->
                <div id="idle-section" class="text-center py-4">
                    <p class="text-secondary text-sm mb-4">Bấm nút bên dưới để bắt đầu quét tem hàng loạt bằng camera.</p>
                    <button id="btn-start-scan" type="button" class="btn bg-gradient-primary btn-lg">
                        📷 Quét mã
                    </button>
                </div>

                <!-- ===== TRẠNG THÁI 2: ĐANG QUÉT ===== -->
                <div id="scan-section" class="d-none">
                    <div id="scan-reader" class="mx-auto" style="max-width: 480px; border-radius: 0.75rem; overflow: hidden; background: #000;"></div>

                    <div class="text-center mt-3">
                        <p id="scan-status" class="text-secondary text-sm mb-0">Chưa quét mã nào — đưa tem vào khung hình camera</p>
                    </div>

                    <div id="scan-list-wrapper" class="mt-3 d-none">
                        <ul id="scan-list" class="list-group" style="max-height: 260px; overflow-y: auto;"></ul>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button id="btn-cancel" type="button" class="btn btn-outline-secondary">
                            ✖️ Huỷ
                        </button>
                        <button id="btn-finish" type="button" class="btn bg-gradient-dark" disabled>
                            OK (0 mã)
                        </button>
                    </div>
                </div>

                <!-- ===== TRẠNG THÁI 3: KẾT QUẢ (sau khi bấm OK) ===== -->
                <div id="summary-section" class="d-none">
                    <div class="text-center mb-4">
                        <p class="text-secondary text-sm mb-1">Tổng số PCard đã quét</p>
                        <h2 class="mb-0" id="summary-count">0</h2>
                    </div>
                    <ul id="summary-list" class="list-group mb-4"></ul>
                    <div class="text-center">
                        <button id="btn-rescan" type="button" class="btn bg-gradient-info">
                            🔄 Quét lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/dist/html5-qrcode.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/scan.js" asp-append-version="true"></script>
}
